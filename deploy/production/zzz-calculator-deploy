    assert_release_tree_shape "$root"
    release_matches_exact_contract "$root" "$APP_USER" "$APP_GROUP" 755 644 \
        || die "legacy current release does not match its exact zzzcalc-owned 0755/0644 contract"
    [[ "$CURRENT_TREE_SHA256_BEFORE" == "$LEGACY_CURRENT_TREE_SHA256" ]] \
        || die "legacy current release content does not match the audited baseline"
    [[ "$CURRENT_PORTABLE_SHA256_BEFORE" == "$LEGACY_CURRENT_PORTABLE_SHA256" ]] \
        || die "legacy current release portable tree does not match the audited baseline"
    [[ "$CURRENT_STATIC_SHA256_BEFORE" == "$LEGACY_CURRENT_STATIC_SHA256" ]] \
        || die "legacy current release static tree does not match the audited baseline"
    [[ -f "$example_inventory" && ! -L "$example_inventory" \
        && "$(stat -c '%h:%s' -- "$example_inventory")" == "1:188" \
        && "$(sha256sum -- "$example_inventory" | awk '{print $1}')" == "$LEGACY_EXAMPLE_INVENTORY_SHA256" ]] \
        || die "legacy example inventory does not match the audited baseline"
    [[ ! -e "$root/data/user_drive_discs.json" && ! -L "$root/data/user_drive_discs.json" ]] \
