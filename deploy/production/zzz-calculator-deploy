        && "$SYSTEMD_EFFECTIVE_VERSION" -ge "$MIN_SYSTEMD_VERSION" ]] \
        || die "validation systemd profile was not initialized"
    [[ -n "$VALIDATION_JOB_DIR" && "$release_dir" == "$VALIDATION_JOB_DIR/"* \
        && -d "$release_dir" && ! -L "$release_dir" ]] \
        || die "validation bind source is outside the private validation job"

    denied_syscalls="${VALIDATION_DENIED_SYSCALLS[*]}"
    VALIDATION_SYSTEMD_PROPERTIES=(
        --property Type=oneshot
        --property RemainAfterExit=yes
        --property "User=$VALIDATION_USER"
        --property "Group=$VALIDATION_GROUP"
        --property SupplementaryGroups=
