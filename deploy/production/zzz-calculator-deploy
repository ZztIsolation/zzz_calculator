    telemetry_dir="$(process_environment_value "$pid" SCAN_TELEMETRY_DIR || true)"
    [[ -z "$telemetry_dir" ]] || die "effective production process has SCAN_TELEMETRY_DIR configured"
    telemetry_enabled="$(process_environment_value "$pid" SCAN_TELEMETRY_ENABLED || true)"
