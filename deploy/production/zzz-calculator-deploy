write_state_file() {
    local name="$1"
    local value="$2"
    local temporary="${DEPLOY_ROOT}/.${name}.$$"
    [[ "$name" == "previous-release" || "$name" == "last-release" ]] || return 1
    [[ "$value" =~ ^(git|rollback)-[0-9a-f]{7,40}$ ]] || return 1
    [[ ! -e "$temporary" && ! -L "$temporary" ]] || return 1
    printf '%s\n' "$value" >"$temporary" || return 1
    chown root:root "$temporary" || { rm -f -- "$temporary"; return 1; }
    chmod 0640 "$temporary" || { rm -f -- "$temporary"; return 1; }
    mv -Tf -- "$temporary" "${DEPLOY_ROOT}/${name}" || { rm -f -- "$temporary"; return 1; }
}

write_migration_marker() {
    local temporary="${DEPLOY_ROOT}/.legacy-current-migrated.$$"
    if [[ -e "$LEGACY_MIGRATION_MARKER" || -L "$LEGACY_MIGRATION_MARKER" ]]; then
        [[ -f "$LEGACY_MIGRATION_MARKER" && ! -L "$LEGACY_MIGRATION_MARKER" \
            && "$(stat -c '%U:%G:%a:%h:%s' -- "$LEGACY_MIGRATION_MARKER")" == "root:root:640:1:41" \
            && "$(<"$LEGACY_MIGRATION_MARKER")" == "$LEGACY_CURRENT_COMMIT" ]]
        return
    fi
    [[ ! -e "$temporary" && ! -L "$temporary" ]] || return 1
    printf '%s\n' "$LEGACY_CURRENT_COMMIT" >"$temporary" || return 1
    chown root:root "$temporary" || { rm -f -- "$temporary"; return 1; }
    chmod 0640 "$temporary" || { rm -f -- "$temporary"; return 1; }
    mv -T -- "$temporary" "$LEGACY_MIGRATION_MARKER" || { rm -f -- "$temporary"; return 1; }
}

record_managed_current() {
    local previous="$1"
    local last="$2"
    write_state_file previous-release "$previous" || return 1
    write_state_file last-release "$last" || return 1
    write_migration_marker || return 1
    [[ "$(<"$DEPLOY_ROOT/previous-release")" == "$previous" \
        && "$(<"$DEPLOY_ROOT/last-release")" == "$last" \
        && "$(<"$LEGACY_MIGRATION_MARKER")" == "$LEGACY_CURRENT_COMMIT" ]]
}

