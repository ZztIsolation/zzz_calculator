health_gate() {
    local attempt current_pid observed_pid="" startup_deadline

    HEALTH_GATE_PID=""
    startup_deadline="$((SECONDS + HEALTH_STARTUP_GRACE_SECONDS))"
    while ((SECONDS < startup_deadline)); do
        if current_pid="$(healthy_runtime_pid)"; then
            observed_pid="$current_pid"
            break
        fi
        ((SECONDS < startup_deadline)) || break
        sleep 1
    done
    [[ -n "$observed_pid" ]] || return 1

    for ((attempt = 1; attempt <= HEALTH_STABILITY_SECONDS; attempt++)); do
        current_pid="$(healthy_runtime_pid)" || return 1
        [[ "$current_pid" == "$observed_pid" ]] || return 1
        sleep 1
    done
    HEALTH_GATE_PID="$observed_pid"
    return 0
}

