parse_systemd_major_version() {
    local raw="$1"
    local first_line

    first_line="${raw%%$'\n'*}"
    first_line="${first_line%$'\r'}"
    if [[ "$first_line" =~ ^systemd[[:space:]]+([0-9]+)([[:space:]].*)?$ ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
        return 0
    fi
    if [[ "$first_line" =~ ^([0-9]+)([[:space:]].*)?$ ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
        return 0
    fi
    return 1
}

select_validation_systemd_profile() {
    local run_version="$1"
    local manager_version="$2"
    local effective_version

    [[ "$run_version" =~ ^[1-9][0-9]*$ && "$manager_version" =~ ^[1-9][0-9]*$ ]] \
        || die "systemd version values are invalid"

    if (( run_version < manager_version )); then
        effective_version="$run_version"
    else
        effective_version="$manager_version"
    fi
    SYSTEMD_RUN_VERSION="$run_version"
    SYSTEMD_MANAGER_VERSION="$manager_version"
    SYSTEMD_EFFECTIVE_VERSION="$effective_version"
    (( effective_version >= MIN_SYSTEMD_VERSION )) \
        || die "systemd ${effective_version} is unsupported; validation requires systemd ${MIN_SYSTEMD_VERSION} or newer"

    VALIDATION_SANDBOX_PROFILE="$VALIDATION_SANDBOX_PROFILE_BASE"
    if (( effective_version >= RESTRICT_SUID_SGID_SYSTEMD_VERSION )); then
        VALIDATION_SANDBOX_PROFILE+="+restrict-suidsgid"
    fi
    if (( effective_version >= PRIVATE_IPC_SYSTEMD_VERSION )); then
        VALIDATION_SANDBOX_PROFILE+="+private-ipc"
    fi
    log "validation sandbox systemdRun=${SYSTEMD_RUN_VERSION} manager=${SYSTEMD_MANAGER_VERSION} effective=${SYSTEMD_EFFECTIVE_VERSION} profile=${VALIDATION_SANDBOX_PROFILE}"
}

detect_validation_systemd_profile() {
    local run_output manager_output run_version manager_version

    run_output="$(/usr/bin/systemd-run --version)" \
        || die "cannot query the systemd-run client version"
    manager_output="$(/usr/bin/systemctl show --property=Version --value)" \
        || die "cannot query the PID 1 systemd manager version"
    run_version="$(parse_systemd_major_version "$run_output")" \
        || die "cannot parse the systemd-run client version"
    manager_version="$(parse_systemd_major_version "$manager_output")" \
        || die "cannot parse the PID 1 systemd manager version"
    select_validation_systemd_profile "$run_version" "$manager_version"
}

build_validation_systemd_properties() {
