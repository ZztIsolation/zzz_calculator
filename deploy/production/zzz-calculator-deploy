assert_release_tree_shape() {
    local root="$1"
    local root_device observed_device path usage entries files bytes max_depth
    [[ -d "$root" && ! -L "$root" ]] || die "release is not a real directory"
    root_device="$(stat -c '%d' -- "$root")"
    while IFS= read -r -d '' path; do
        observed_device="$(stat -c '%d' -- "$path")"
        [[ "$observed_device" == "$root_device" ]] \
            || die "release contains a nested mount or different device"
    done < <(find "$root" -xdev -print0)
    while IFS= read -r -d '' path; do
        mountpoint -q -- "$path" && die "release contains a nested mount point"
    done < <(find "$root" -xdev -mindepth 1 -type d -print0)
    if find "$root" -xdev -type l -print -quit | grep -q .; then
        die "release contains a symbolic link"
    fi
    if find "$root" -xdev ! -type d ! -type f -print -quit | grep -q .; then
        die "release contains a special path"
    fi
    if find "$root" -xdev -type f ! -links 1 -print -quit | grep -q .; then
        die "release contains a hard-linked file"
    fi
    usage="$(tree_usage "$root")"
    IFS=: read -r entries files bytes <<<"$usage"
    [[ "$entries" =~ ^[0-9]+$ && "$files" =~ ^[0-9]+$ && "$bytes" =~ ^[0-9]+$ ]] \
        || die "release usage cannot be measured"
    (( entries <= MAX_CURRENT_SNAPSHOT_ENTRIES )) || die "release exceeds the entry limit"
    (( bytes <= MAX_CURRENT_SNAPSHOT_BYTES )) || die "release exceeds the size limit"
    max_depth="$(find "$root" -xdev -printf '%d\n' | LC_ALL=C sort -nr | head -n 1)"
    [[ "$max_depth" =~ ^[0-9]+$ && "$max_depth" -le "$MAX_RELEASE_DEPTH" ]] \
        || die "release exceeds the path depth limit"
}

release_matches_exact_contract() {
    local root="$1"
    local owner="$2"
    local group="$3"
    local directory_mode="$4"
    local file_mode="$5"

    [[ "$(stat -c '%U:%G:%a' -- "$root")" == "${owner}:${group}:${directory_mode}" ]] || return 1
    if find "$root" -xdev -type d \( ! -user "$owner" -o ! -group "$group" -o ! -perm "$directory_mode" \) \
        -print -quit | grep -q .; then
        return 1
    fi
    if find "$root" -xdev -type f \( ! -user "$owner" -o ! -group "$group" -o ! -perm "$file_mode" \) \
        -print -quit | grep -q .; then
        return 1
    fi
    return 0
}

assert_immutable_release() {
    local root="$1"
    assert_release_tree_shape "$root"
    [[ "$(stat -c '%U:%G:%a' -- "$root")" == "root:root:755" ]] || die "release root must be root-owned mode 0755"
    if find "$root" -xdev \( ! -user root -o ! -group root \) -print -quit | grep -q .; then
        die "release contains a non-root-owned path"
    fi
    if find "$root" -xdev -type d ! -perm 0755 -print -quit | grep -q .; then
        die "release contains a directory that is not mode 0755"
    fi
    if find "$root" -xdev -type f ! -perm 0644 -print -quit | grep -q .; then
        die "release contains a file that is not mode 0644"
    fi
    assert_release_tree_access_for_user "$root" "$APP_USER"
    assert_release_tree_access_for_user "$root" "$VALIDATION_USER"
}

assert_legacy_current_release() {
    local root="$1"
