validate_evidence_json() {
    local evidence_file="$1"
    jq -e '
        def hex40: test("^[0-9a-f]{40}$");
        def hex64: test("^[0-9a-f]{64}$");
        def natural: test("^[0-9]+$");
        def positive: test("^[1-9][0-9]*$");
        def managed_basename: test("^(git|rollback)-[0-9a-f]{7,40}$");
        def state_flag: . == "0" or . == "1";
        def state_value_valid($exists; $value):
            if $exists == "1" then ($value | managed_basename) else $value == "" end;
        def marker_value_valid($exists; $value):
            if $exists == "1" then ($value | hex40) else $value == "" end;
        def state_snapshot_unchanged:
            .statePreviousExistedBefore == .statePreviousExistedAfter
            and .statePreviousBefore == .statePreviousAfter
            and .stateLastExistedBefore == .stateLastExistedAfter
            and .stateLastBefore == .stateLastAfter
            and .migrationMarkerExistedBefore == .migrationMarkerExistedAfter
            and .migrationMarkerValueBefore == .migrationMarkerValueAfter;
        def artifact_metadata_complete:
            (.artifact | test("^zzz-calculator-server-[0-9a-f]{7,40}\\.tar\\.gz$"))
            and ((.artifact | capture("^zzz-calculator-server-(?<prefix>[0-9a-f]{7,40})\\.tar\\.gz$").prefix) as $prefix
                | (.deployedCommit | startswith($prefix)))
            and (.artifactSizeBytes | positive)
            and (.artifactSha256 | hex64)
            and (.deployedCommit | hex40)
            and (.release | test("^git-[0-9a-f]{12}$"))
            and .release == ("git-" + .deployedCommit[0:12])
            and (.archiveEntryCount | positive)
            and (.archiveExpandedBytes | positive)
            and (.diskRequiredBytes | positive)
            and (.diskAvailableBytes | positive)
            and (.diskRequiredInodes | positive)
            and (.diskAvailableInodes | positive)
            and (.releaseTreeSha256 | hex64)
            and (.pagesTreeSha256 | hex64);
        def validation_complete:
            .validationSequence == "current,candidate,rollback,candidate"
            and .validationUnitResults == "current:active/exited/success/0\ncandidate:active/exited/success/0\nrollback:active/exited/success/0\ncandidate:active/exited/success/0\n";
        def sandbox_profile_valid:
            (.systemdRunVersion | tonumber) as $client
            | (.systemdManagerVersion | tonumber) as $manager
            | (.systemdEffectiveVersion | tonumber) as $effective
            | $effective == ([$client, $manager] | min)
            and (if $effective >= 248 then
                .validationSandboxProfile == "systemd-v239-seccomp+restrict-suidsgid+private-ipc"
            elif $effective >= 242 then
                .validationSandboxProfile == "systemd-v239-seccomp+restrict-suidsgid"
            else
                .validationSandboxProfile == "systemd-v239-seccomp"
            end);
        def managed_state_after:
            .statePreviousExistedAfter == "1"
            and (.statePreviousAfter | managed_basename)
            and .stateLastExistedAfter == "1"
            and (.stateLastAfter | managed_basename)
            and .migrationMarkerExistedAfter == "1"
            and .migrationMarkerValueAfter == "2e7f874bc034871f03b5738f48d7d05685b36ea9";
        def required_keys: [
            "action", "status", "startedAt", "completedAt", "error",
            "artifact", "artifactSizeBytes", "artifactSha256", "deployedCommit",
            "release", "rollbackRelease", "previousRelease", "currentBefore",
            "currentAfter", "currentCommitBefore", "currentCommitAfter",
            "currentReleasePolicy", "currentTreeSha256Before",
            "currentTreeSha256After", "currentPortableSha256Before",
            "currentPortableSha256After", "currentStaticSha256Before",
            "currentStaticSha256After", "currentTreeMetadataSha256Before",
            "currentTreeMetadataSha256After", "currentTreeEntryCount",
            "currentTreeFileCount", "currentTreeBytes",
            "statePreviousExistedBefore", "statePreviousBefore",
            "statePreviousExistedAfter", "statePreviousAfter",
            "stateLastExistedBefore", "stateLastBefore",
            "stateLastExistedAfter", "stateLastAfter",
            "migrationMarkerExistedBefore", "migrationMarkerValueBefore",
            "migrationMarkerExistedAfter", "migrationMarkerValueAfter",
            "serviceBefore", "serviceAfter", "pidBefore", "pidAfter",
            "nRestartsBefore", "nRestartsAfter", "nginx", "nginxBefore",
            "nginxAfter", "disk", "diskBefore", "diskAfter", "memory",
            "memoryBefore", "memoryAfter", "helperManifestSha256",
            "scannerManifestSha256", "helperManifestSha256Before",
            "helperManifestSha256After", "scannerManifestSha256Before",
            "scannerManifestSha256After", "archiveEntryCount",
            "archiveExpandedBytes", "diskRequiredBytes", "diskAvailableBytes",
            "diskRequiredInodes", "diskAvailableInodes",
            "validationSequence", "validationUnitResults",
            "systemdRunVersion", "systemdManagerVersion",
            "systemdEffectiveVersion", "validationSandboxProfile",
            "validationSandboxProbe", "validationCleanup", "switchState", "releaseTreeSha256",
            "pagesTreeSha256"
        ] | sort;
        type == "object"
        and (keys == required_keys)
        and (all(.[]; type == "string"))
        and (.action as $action | (["audit", "dry-run", "deploy", "rollback"] | index($action)) != null)
        and (.status as $status | (["success", "failed"] | index($status)) != null)
        and (.switchState as $state | (["not-switched", "rolled-back", "committed", "armed", "switched"] | index($state)) != null)
        and (.startedAt | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"))
        and (.completedAt | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"))
        and ((.status == "success" and .error == "") or (.status == "failed" and (.error | length) > 0))
        and (.artifactSha256 == "" or (.artifactSha256 | hex64))
        and (.deployedCommit == "" or (.deployedCommit | hex40))
        and (.currentReleasePolicy as $policy | (["", "legacy-writable", "managed-immutable"] | index($policy)) != null)
        and (all([
            .currentTreeSha256Before,
            .currentTreeSha256After,
            .currentPortableSha256Before,
            .currentPortableSha256After,
            .currentStaticSha256Before,
            .currentStaticSha256After,
            .currentTreeMetadataSha256Before,
            .currentTreeMetadataSha256After,
            .releaseTreeSha256,
            .pagesTreeSha256
        ][]; . == "" or hex64))
        and (all([
            .artifactSizeBytes,
            .archiveEntryCount,
            .archiveExpandedBytes,
            .diskRequiredBytes,
            .diskAvailableBytes,
            .nRestartsBefore,
            .nRestartsAfter,
            .currentTreeEntryCount,
            .currentTreeFileCount,
            .currentTreeBytes,
            .diskRequiredInodes,
            .diskAvailableInodes
        ][]; . == "" or natural))
        and (all([
            .systemdRunVersion,
            .systemdManagerVersion,
            .systemdEffectiveVersion
        ][]; . == "" or positive))
        and (.validationSandboxProfile == ""
            or (.validationSandboxProfile | test("^systemd-v239-seccomp(\\+restrict-suidsgid)?(\\+private-ipc)?$")))
        and (.validationSandboxProbe == "not-run"
            or (.validationSandboxProbe | test("^[a-z][a-z0-9-]{0,31}/[a-z][a-z0-9-]{0,31}/[a-z][a-z0-9-]{0,31}/([0-9]+|unknown)$")))
        and (.validationCleanup as $cleanup | (["not-run", "clean", "failed"] | index($cleanup)) != null)
        and (if .status == "success" then
            .currentReleasePolicy != ""
            and (.currentBefore | test("^/opt/zzz_calculator/releases/(git|rollback)-[0-9a-f]{7,40}$"))
            and (.currentAfter | test("^/opt/zzz_calculator/releases/(git|rollback)-[0-9a-f]{7,40}$"))
            and (.currentCommitBefore | hex40)
            and (.currentCommitAfter | hex40)
            and (all([
                .currentTreeSha256Before,
                .currentTreeSha256After,
                .currentPortableSha256Before,
                .currentPortableSha256After,
                .currentStaticSha256Before,
                .currentStaticSha256After,
                .currentTreeMetadataSha256Before,
                .currentTreeMetadataSha256After
            ][]; hex64))
            and (all([
                .currentTreeEntryCount,
                .currentTreeFileCount,
                .currentTreeBytes
            ][]; natural))
            and (.statePreviousExistedBefore | state_flag)
            and (.statePreviousExistedAfter | state_flag)
            and (.stateLastExistedBefore | state_flag)
            and (.stateLastExistedAfter | state_flag)
            and (.migrationMarkerExistedBefore | state_flag)
            and (.migrationMarkerExistedAfter | state_flag)
            and state_value_valid(.statePreviousExistedBefore; .statePreviousBefore)
            and state_value_valid(.statePreviousExistedAfter; .statePreviousAfter)
            and state_value_valid(.stateLastExistedBefore; .stateLastBefore)
            and state_value_valid(.stateLastExistedAfter; .stateLastAfter)
            and marker_value_valid(.migrationMarkerExistedBefore; .migrationMarkerValueBefore)
            and marker_value_valid(.migrationMarkerExistedAfter; .migrationMarkerValueAfter)
            and .serviceBefore == "active"
            and .serviceAfter == "active"
            and (.pidBefore | positive)
            and (.pidAfter | positive)
            and (.nRestartsBefore | natural)
            and (.nRestartsAfter | natural)
            and .nRestartsBefore == .nRestartsAfter
            and (.systemdRunVersion | positive)
            and (.systemdManagerVersion | positive)
            and (.systemdEffectiveVersion | positive)
            and ((.systemdEffectiveVersion | tonumber) >= 239)
            and (.validationSandboxProfile | test("^systemd-v239-seccomp(\\+restrict-suidsgid)?(\\+private-ipc)?$"))
            and sandbox_profile_valid
            and .nginxBefore == "valid"
            and .nginxAfter == "valid"
            and (.helperManifestSha256Before | hex64)
            and .helperManifestSha256Before == .helperManifestSha256After
            and (.scannerManifestSha256Before | hex64)
            and .scannerManifestSha256Before == .scannerManifestSha256After
            and (.switchState == "not-switched" or .switchState == "committed")
        else true end)
        and (if .status == "success" and .switchState == "not-switched" then
            .currentBefore == .currentAfter
            and .currentCommitBefore == .currentCommitAfter
            and .currentTreeSha256Before == .currentTreeSha256After
            and .currentPortableSha256Before == .currentPortableSha256After
            and .currentStaticSha256Before == .currentStaticSha256After
            and .currentTreeMetadataSha256Before == .currentTreeMetadataSha256After
        else true end)
        and (if .status == "failed" and .switchState == "not-switched" and .currentBefore != "" then
            .currentBefore == .currentAfter
            and .currentCommitBefore == .currentCommitAfter
            and .currentTreeSha256Before == .currentTreeSha256After
            and .currentPortableSha256Before == .currentPortableSha256After
            and .currentStaticSha256Before == .currentStaticSha256After
            and .currentTreeMetadataSha256Before == .currentTreeMetadataSha256After
            and state_snapshot_unchanged
            and .serviceBefore == "active"
            and .serviceAfter == .serviceBefore
            and (.pidBefore | positive)
            and .pidAfter == .pidBefore
            and (.nRestartsBefore | natural)
            and .nRestartsAfter == .nRestartsBefore
            and .nginxBefore == "valid"
            and .nginxAfter == .nginxBefore
            and (.helperManifestSha256Before | hex64)
            and .helperManifestSha256After == .helperManifestSha256Before
            and (.scannerManifestSha256Before | hex64)
            and .scannerManifestSha256After == .scannerManifestSha256Before
        else true end)
        and (if .status == "success" and .action == "audit" then
            .switchState == "not-switched"
            and .artifact == ""
            and .artifactSizeBytes == ""
            and .artifactSha256 == ""
            and .deployedCommit == ""
            and .release == ""
            and .rollbackRelease == ""
            and .previousRelease == ""
            and .archiveEntryCount == ""
            and .archiveExpandedBytes == ""
            and .diskRequiredBytes == ""
            and .diskAvailableBytes == ""
            and .diskRequiredInodes == ""
            and .diskAvailableInodes == ""
            and .validationSequence == ""
            and .validationUnitResults == ""
            and .validationSandboxProbe == "not-run"
            and .validationCleanup == "not-run"
            and .releaseTreeSha256 == ""
            and .pagesTreeSha256 == ""
            and state_snapshot_unchanged
        else true end)
        and (if .status == "success" and .action == "dry-run" then
            .switchState == "not-switched"
            and artifact_metadata_complete
            and (.rollbackRelease | test("^validation-rollback-[0-9a-f]{12}$"))
            and .previousRelease == ""
            and validation_complete
            and .validationSandboxProbe == "active/exited/success/0"
            and .validationCleanup == "clean"
            and state_snapshot_unchanged
        else true end)
        and (if .status == "success" and .action == "deploy" then
            artifact_metadata_complete
            and .validationSandboxProbe == "active/exited/success/0"
            and .validationCleanup == "clean"
            and (.rollbackRelease | test("^rollback-[0-9a-f]{12}$"))
            and .rollbackRelease == ("rollback-" + .deployedCommit[0:12])
            and .currentAfter == ("/opt/zzz_calculator/releases/" + .release)
            and .currentCommitAfter == .deployedCommit
            and (if .switchState == "committed" then
                validation_complete
                and managed_state_after
                and .statePreviousAfter == .rollbackRelease
                and .stateLastAfter == .release
            else
                .switchState == "not-switched"
                and state_snapshot_unchanged
            end)
        else true end)
        and (if .status == "success" and .action == "rollback" then
            .artifact == ""
            and .artifactSizeBytes == ""
            and .artifactSha256 == ""
            and (.deployedCommit | hex40)
            and .release == ""
            and (.rollbackRelease | managed_basename)
            and (.previousRelease | managed_basename)
            and .archiveEntryCount == ""
            and .archiveExpandedBytes == ""
            and .diskRequiredBytes == ""
            and .diskAvailableBytes == ""
            and .diskRequiredInodes == ""
            and .diskAvailableInodes == ""
            and .currentAfter == ("/opt/zzz_calculator/releases/" + .rollbackRelease)
            and .currentCommitAfter == .deployedCommit
            and .validationSequence == ""
            and .validationUnitResults == ""
            and .validationSandboxProbe == "not-run"
            and .validationCleanup == "not-run"
            and .releaseTreeSha256 == ""
            and .pagesTreeSha256 == ""
            and (if .switchState == "committed" then
                managed_state_after
                and .statePreviousAfter == .previousRelease
                and .stateLastAfter == .rollbackRelease
            else
                .switchState == "not-switched"
                and state_snapshot_unchanged
            end)
        else true end)
    ' -- "$evidence_file" >/dev/null
}

read_commit() {
    local release_dir="${1:-}"
    local value=""
    local metadata="${release_dir}/.deployed-commit"
    [[ -n "$release_dir" && -f "$metadata" && ! -L "$metadata" ]] || return 0
    [[ "$(stat -c '%h:%s' -- "$metadata" 2>/dev/null || true)" == "1:41" ]] || return 0
    value="$(<"$metadata")"
    [[ "$value" =~ ^[0-9a-f]{40}$ ]] || return 0
    printf '%s' "$value"
}

current_target() {
    readlink -e -- "$CURRENT_LINK" 2>/dev/null || true
}

current_path_is_bounded_for_read() {
    local path="${1:-}"
    local canonical root_device path_device

    [[ -L "$CURRENT_LINK" ]] || return 1
    [[ -n "$path" && "$path" == "$RELEASE_ROOT/"* ]] || return 1
    [[ -d "$path" && ! -L "$path" ]] || return 1
    canonical="$(realpath -e -- "$path" 2>/dev/null || true)"
    [[ "$canonical" == "$path" ]] || return 1
    root_device="$(stat -c '%d' -- "$RELEASE_ROOT" 2>/dev/null || true)"
    path_device="$(stat -c '%d' -- "$path" 2>/dev/null || true)"
    [[ -n "$root_device" && "$path_device" == "$root_device" ]]
}

service_property() {
    local property="$1"
    systemctl show "$SERVICE_NAME" --property "$property" --value 2>/dev/null || true
}

manifest_sha256() {
    local manifest="$1"
    if [[ -f "$manifest" ]]; then
        sha256sum -- "$manifest" | awk '{print $1}'
    fi
}

capture_before() {
    local usage
    CURRENT_BEFORE="$(current_target)"
    if current_path_is_bounded_for_read "$CURRENT_BEFORE"; then
        CURRENT_COMMIT_BEFORE="$(read_commit "$CURRENT_BEFORE")"
        usage="$(tree_usage "$CURRENT_BEFORE")"
        IFS=: read -r CURRENT_TREE_ENTRY_COUNT CURRENT_TREE_FILE_COUNT CURRENT_TREE_BYTES <<<"$usage"
        CURRENT_TREE_SHA256_BEFORE="$(tree_sha256 "$CURRENT_BEFORE")"
        CURRENT_PORTABLE_SHA256_BEFORE="$(portable_tree_sha256 "$CURRENT_BEFORE" full)"
        CURRENT_STATIC_SHA256_BEFORE="$(portable_tree_sha256 "$CURRENT_BEFORE" static)"
        CURRENT_TREE_METADATA_SHA256_BEFORE="$(tree_metadata_sha256 "$CURRENT_BEFORE")"
    fi
    SERVICE_BEFORE="$(systemctl is-active "$SERVICE_NAME" 2>/dev/null || true)"
    PID_BEFORE="$(service_property MainPID)"
    RESTARTS_BEFORE="$(service_property NRestarts)"
    HELPER_MANIFEST_SHA256_BEFORE="$(manifest_sha256 "$HELPER_MANIFEST")"
    SCANNER_MANIFEST_SHA256_BEFORE="$(manifest_sha256 "$SCANNER_MANIFEST")"
    DISK_STATUS="$(df -P /opt /srv 2>/dev/null | tr '\n' ' ' || true)"
    MEMORY_STATUS="$(free -h 2>/dev/null | tr '\n' ' ' || true)"
    if command -v nginx >/dev/null 2>&1 && nginx -t >/dev/null 2>&1; then
        NGINX_STATUS="valid"
    else
        NGINX_STATUS="invalid"
    fi
}

capture_after() {
    CURRENT_AFTER="$(current_target)"
    if current_path_is_bounded_for_read "$CURRENT_AFTER"; then
        CURRENT_COMMIT_AFTER="$(read_commit "$CURRENT_AFTER")"
        CURRENT_TREE_SHA256_AFTER="$(tree_sha256 "$CURRENT_AFTER")"
        CURRENT_PORTABLE_SHA256_AFTER="$(portable_tree_sha256 "$CURRENT_AFTER" full)"
        CURRENT_STATIC_SHA256_AFTER="$(portable_tree_sha256 "$CURRENT_AFTER" static)"
        CURRENT_TREE_METADATA_SHA256_AFTER="$(tree_metadata_sha256 "$CURRENT_AFTER")"
    else
        CURRENT_COMMIT_AFTER=""
        CURRENT_TREE_SHA256_AFTER=""
        CURRENT_PORTABLE_SHA256_AFTER=""
        CURRENT_STATIC_SHA256_AFTER=""
        CURRENT_TREE_METADATA_SHA256_AFTER=""
    fi
    SERVICE_AFTER="$(systemctl is-active "$SERVICE_NAME" 2>/dev/null || true)"
    PID_AFTER="$(service_property MainPID)"
    RESTARTS_AFTER="$(service_property NRestarts)"
    HELPER_MANIFEST_SHA256_AFTER="$(manifest_sha256 "$HELPER_MANIFEST")"
    SCANNER_MANIFEST_SHA256_AFTER="$(manifest_sha256 "$SCANNER_MANIFEST")"
    DISK_STATUS_AFTER="$(df -P /opt /srv 2>/dev/null | tr '\n' ' ' || true)"
    MEMORY_STATUS_AFTER="$(free -h 2>/dev/null | tr '\n' ' ' || true)"
    if command -v nginx >/dev/null 2>&1 && nginx -t >/dev/null 2>&1; then
        NGINX_STATUS_AFTER="valid"
    else
        NGINX_STATUS_AFTER="invalid"
    fi
}

capture_state_file_for_evidence() {
    local name="$1"
    local existed_variable="$2"
    local value_variable="$3"
    local path="${DEPLOY_ROOT}/${name}"
    local metadata size value

    printf -v "$existed_variable" '%s' 'invalid'
    printf -v "$value_variable" '%s' ''
    if [[ ! -e "$path" && ! -L "$path" ]]; then
        printf -v "$existed_variable" '%s' '0'
        return 0
    fi
    [[ -f "$path" && ! -L "$path" ]] || return 0
    metadata="$(stat -c '%U:%G:%a:%h' -- "$path" 2>/dev/null || true)"
    [[ "$metadata" == "root:root:640:1" ]] || return 0
    size="$(stat -c '%s' -- "$path" 2>/dev/null || true)"
    [[ "$size" =~ ^[1-9][0-9]*$ && "$size" -le 128 ]] || return 0
    IFS= read -r value <"$path" || return 0
    [[ "$value" =~ ^(git|rollback)-[0-9a-f]{7,40}$ ]] || return 0
    [[ "$size" -eq $((${#value} + 1)) ]] || return 0
    printf -v "$existed_variable" '%s' '1'
    printf -v "$value_variable" '%s' "$value"
}

capture_migration_marker_for_evidence() {
    local metadata size value

    LEGACY_MIGRATION_MARKER_EXISTED_AFTER="invalid"
    LEGACY_MIGRATION_MARKER_VALUE_AFTER=""
    if [[ ! -e "$LEGACY_MIGRATION_MARKER" && ! -L "$LEGACY_MIGRATION_MARKER" ]]; then
        LEGACY_MIGRATION_MARKER_EXISTED_AFTER="0"
        return 0
    fi
    [[ -f "$LEGACY_MIGRATION_MARKER" && ! -L "$LEGACY_MIGRATION_MARKER" ]] || return 0
    metadata="$(stat -c '%U:%G:%a:%h' -- "$LEGACY_MIGRATION_MARKER" 2>/dev/null || true)"
    [[ "$metadata" == "root:root:640:1" ]] || return 0
    size="$(stat -c '%s' -- "$LEGACY_MIGRATION_MARKER" 2>/dev/null || true)"
    [[ "$size" == "41" ]] || return 0
    IFS= read -r value <"$LEGACY_MIGRATION_MARKER" || return 0
    [[ "$value" == "$LEGACY_CURRENT_COMMIT" ]] || return 0
    LEGACY_MIGRATION_MARKER_EXISTED_AFTER="1"
    LEGACY_MIGRATION_MARKER_VALUE_AFTER="$value"
}

capture_state_after_for_evidence() {
    capture_state_file_for_evidence previous-release STATE_PREVIOUS_EXISTED_AFTER STATE_PREVIOUS_AFTER
    capture_state_file_for_evidence last-release STATE_LAST_EXISTED_AFTER STATE_LAST_AFTER
    capture_migration_marker_for_evidence
}

write_evidence() {
    local completed_at evidence_tmp reported_switch_state
    local suffix="${DEPLOYED_COMMIT:0:12}"
    capture_state_after_for_evidence
    completed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    [[ -n "$suffix" ]] || suffix="none"
    reported_switch_state="$SWITCH_STATE"
    if [[ "$STATUS" == "success" && "$SWITCH_STATE" == "switched" ]]; then
        reported_switch_state="committed"
    fi

    EVIDENCE_PATH="${HISTORY_DIR}/$(date -u +%Y%m%dT%H%M%SZ)-${ACTION:-unknown}-${suffix}-$$.json"
    [[ ! -e "$EVIDENCE_PATH" && ! -L "$EVIDENCE_PATH" ]] || return 1
    evidence_tmp="$(mktemp "${HISTORY_DIR}/.evidence.XXXXXXXX")" || return 1
    emit_evidence_json "$reported_switch_state" "$completed_at" >"$evidence_tmp" \
        || { rm -f -- "$evidence_tmp"; return 1; }
    validate_evidence_json "$evidence_tmp" || { rm -f -- "$evidence_tmp"; return 1; }
    chmod 0640 "$evidence_tmp" || { rm -f -- "$evidence_tmp"; return 1; }
    mv -T -- "$evidence_tmp" "$EVIDENCE_PATH" || { rm -f -- "$evidence_tmp"; return 1; }
}

cleanup_processing_job() {
    [[ -n "$PROCESSING_JOB_DIR" ]] || return 0
    [[ "$PROCESSING_JOB_DIR" == "$PROCESSING_DIR/job."* ]] || return 1
    [[ -d "$PROCESSING_JOB_DIR" && ! -L "$PROCESSING_JOB_DIR" ]] || return 0
    if ! rm -rf --one-file-system -- "$PROCESSING_JOB_DIR"; then
        log "ERROR: failed to remove processing directory ${PROCESSING_JOB_DIR}"
        return 1
    fi
    PROCESSING_JOB_DIR=""
}

validation_cgroup_has_members() {
    local control_group="$1"
    local proc_cgroup hierarchy controllers member_path

    [[ "$control_group" == /* ]] || return 1
    for proc_cgroup in /proc/[0-9]*/cgroup; do
        [[ -r "$proc_cgroup" ]] || continue
        while IFS=: read -r hierarchy controllers member_path; do
            if [[ "$member_path" == "$control_group" || "$member_path" == "$control_group/"* ]]; then
                return 0
            fi
        done <"$proc_cgroup"
    done
    return 1
}

validation_unit_name_has_members() {
    local unit="$1"
    local proc_cgroup hierarchy controllers member_path

    [[ "$unit" =~ ^zzz-calculator-validation-[0-9]+-[1-9][0-9]*\.service$ ]] || return 0
    for proc_cgroup in /proc/[0-9]*/cgroup; do
        [[ -r "$proc_cgroup" ]] || continue
        while IFS=: read -r hierarchy controllers member_path; do
            if [[ "$member_path" == */"$unit" || "$member_path" == */"$unit/"* ]]; then
                return 0
            fi
        done <"$proc_cgroup"
    done
    return 1
}

finish_validation_probe_if_gone() {
    local unit="$1"
    local load_state

    [[ "$unit" =~ ^zzz-calculator-validation-[0-9]+-[1-9][0-9]*\.service$ ]] || return 1
    [[ "$VALIDATION_UNIT" == "$unit" ]] || return 1
    load_state="$(systemctl show "$unit" --property LoadState --value 2>/dev/null)" || return 1
    [[ "$load_state" == "not-found" ]] || return 1
    validation_unit_name_has_members "$unit" && return 1
    VALIDATION_UNIT=""
    return 0
}

stop_validation_probe() {
    local unit load_state active_state control_group cgroup_procs attempt
    local control_group_was_realized="0"
    [[ -n "$VALIDATION_UNIT" ]] || return 0
    unit="$VALIDATION_UNIT"
    [[ "$unit" =~ ^zzz-calculator-validation-[0-9]+-[1-9][0-9]*\.service$ ]] || return 1
    if ! load_state="$(systemctl show "$unit" --property LoadState --value 2>/dev/null)"; then
        finish_validation_probe_if_gone "$unit" && return 0
        return 1
    fi
    if [[ "$load_state" == "not-found" ]]; then
        finish_validation_probe_if_gone "$unit"
        return
    fi
    [[ "$load_state" == "loaded" ]] || return 1

    if ! control_group="$(systemctl show "$unit" --property ControlGroup --value 2>/dev/null)"; then
        finish_validation_probe_if_gone "$unit" && return 0
        return 1
    fi
    if [[ -n "$control_group" ]]; then
        [[ "$control_group" == /*/"$unit" ]] || return 1
        control_group_was_realized="1"
    else
        validation_unit_name_has_members "$unit" && return 1
    fi
    if ! systemctl stop "$unit" >/dev/null 2>&1; then
        finish_validation_probe_if_gone "$unit" && return 0
        return 1
    fi
    if [[ "$control_group_was_realized" == "1" ]]; then
        cgroup_procs="/sys/fs/cgroup${control_group}/cgroup.procs"
        if [[ -r "$cgroup_procs" ]] && grep -Eq '[0-9]' -- "$cgroup_procs"; then
            return 1
        fi
        validation_cgroup_has_members "$control_group" && return 1
    fi
    validation_unit_name_has_members "$unit" && return 1

    if ! load_state="$(systemctl show "$unit" --property LoadState --value 2>/dev/null)"; then
        finish_validation_probe_if_gone "$unit" && return 0
        return 1
    fi
    if [[ "$load_state" == "not-found" ]]; then
        finish_validation_probe_if_gone "$unit"
        return
    fi
    [[ "$load_state" == "loaded" ]] || return 1
    if ! active_state="$(systemctl show "$unit" --property ActiveState --value 2>/dev/null)"; then
        finish_validation_probe_if_gone "$unit" && return 0
        return 1
    fi
    [[ "$active_state" == "inactive" || "$active_state" == "failed" ]] || return 1
    if ! systemctl reset-failed "$unit" >/dev/null 2>&1; then
        finish_validation_probe_if_gone "$unit" && return 0
        return 1
    fi

    for attempt in $(seq 1 50); do
        if ! load_state="$(systemctl show "$unit" --property LoadState --value 2>/dev/null)"; then
            finish_validation_probe_if_gone "$unit" && return 0
            return 1
        fi
        if [[ "$load_state" == "not-found" ]]; then
            finish_validation_probe_if_gone "$unit"
            return
        fi
        [[ "$load_state" == "loaded" ]] || return 1
        sleep 0.1
    done
    return 1
}

safe_remove_transient_dir() {
    local target="${1:-}"
    local allowed="0"
    [[ -n "$target" ]] || return 0
    case "$target" in
        "$VALIDATION_DIR"/job.*|"$RELEASE_ROOT"/.candidate.*|"$RELEASE_ROOT"/.rollback.*) allowed="1" ;;
    esac
    [[ "$allowed" == "1" ]] || return 1
    [[ ! -L "$target" ]] || return 1
    [[ -e "$target" ]] || return 0
    rm -rf --one-file-system -- "$target"
}

cleanup_transient_trees() {
    local failed="0"
    local validation_stopped="1"
    local active_state sub_state result exec_status
    if [[ "$VALIDATION_CLEANUP_RESULT" == "pending" ]]; then
        VALIDATION_CLEANUP_RESULT="failed"
    fi
    if [[ -n "$VALIDATION_ACTIVE_LABEL" && -n "$VALIDATION_PROBE_ROOT" ]]; then
        active_state="$(systemctl show "$VALIDATION_UNIT" --property ActiveState --value 2>/dev/null || true)"
        sub_state="$(systemctl show "$VALIDATION_UNIT" --property SubState --value 2>/dev/null || true)"
        result="$(systemctl show "$VALIDATION_UNIT" --property Result --value 2>/dev/null || true)"
        exec_status="$(systemctl show "$VALIDATION_UNIT" --property ExecMainStatus --value 2>/dev/null || true)"
        if ! stop_validation_probe; then
            validation_stopped="0"
            failed="1"
        fi
        record_validation_unit_result "$VALIDATION_ACTIVE_LABEL" "$active_state" "$sub_state" "$result" "$exec_status"
        if [[ "$validation_stopped" == "1" ]]; then
            VALIDATION_ACTIVE_LABEL=""
        fi
    else
        if ! stop_validation_probe; then
            validation_stopped="0"
            failed="1"
        fi
    fi
    safe_remove_transient_dir "$CANDIDATE_STAGING" || failed="1"
    safe_remove_transient_dir "$ROLLBACK_STAGING" || failed="1"
    CANDIDATE_STAGING=""
    ROLLBACK_STAGING=""
    if [[ "$validation_stopped" == "1" ]]; then
        if safe_remove_transient_dir "$VALIDATION_JOB_DIR"; then
            VALIDATION_JOB_DIR=""
            VALIDATION_ACTIVE_LABEL=""
            VALIDATION_PROBE_ROOT=""
            if [[ "$VALIDATION_DIR_EXPOSED" == "1" ]]; then
                if chown root:root "$VALIDATION_DIR" 2>/dev/null \
                    && chmod 0750 "$VALIDATION_DIR" 2>/dev/null; then
                    VALIDATION_DIR_EXPOSED="0"
                else
                    failed="1"
                fi
            fi
        else
            failed="1"
        fi
    fi
    if [[ -n "$NEXT_LINK_PATH" ]]; then
        if [[ "$NEXT_LINK_PATH" != "${CURRENT_LINK}.next.$$" || ( -e "$NEXT_LINK_PATH" && ! -L "$NEXT_LINK_PATH" ) ]]; then
            failed="1"
        else
            rm -f -- "$NEXT_LINK_PATH" 2>/dev/null || failed="1"
            NEXT_LINK_PATH=""
        fi
    fi
    if [[ "$failed" == "0" && "$VALIDATION_CLEANUP_RESULT" != "not-run" ]]; then
        VALIDATION_CLEANUP_RESULT="clean"
    elif [[ "$failed" != "0" && "$VALIDATION_CLEANUP_RESULT" != "not-run" ]]; then
        VALIDATION_CLEANUP_RESULT="failed"
    fi
    [[ "$failed" == "0" ]]
}

read_state_file_snapshot() {
    local name="$1"
    local existed_variable="$2"
    local value_variable="$3"
    local path="${DEPLOY_ROOT}/${name}"
    local value size

    if [[ ! -e "$path" && ! -L "$path" ]]; then
        printf -v "$existed_variable" '%s' '0'
        printf -v "$value_variable" '%s' ''
        return 0
    fi
    [[ -f "$path" && ! -L "$path" ]] || die "deployment state ${name} is not a regular file"
    [[ "$(stat -c '%U:%G:%a:%h' -- "$path")" == "root:root:640:1" ]] \
        || die "deployment state ${name} has unsafe ownership, mode, or link count"
    size="$(stat -c '%s' -- "$path")"
    [[ "$size" =~ ^[1-9][0-9]*$ && "$size" -le 128 ]] \
        || die "deployment state ${name} has an invalid size"
    value="$(<"$path")"
    validate_release_basename "$value"
    [[ "$size" -eq $((${#value} + 1)) ]] \
        || die "deployment state ${name} must contain exactly one newline-terminated basename"
    printf -v "$existed_variable" '%s' '1'
    printf -v "$value_variable" '%s' "$value"
}

read_migration_marker_snapshot() {
    local value size
    if [[ ! -e "$LEGACY_MIGRATION_MARKER" && ! -L "$LEGACY_MIGRATION_MARKER" ]]; then
        LEGACY_MIGRATION_MARKER_EXISTED="0"
        LEGACY_MIGRATION_MARKER_VALUE=""
        return 0
    fi
    [[ -f "$LEGACY_MIGRATION_MARKER" && ! -L "$LEGACY_MIGRATION_MARKER" ]] \
        || die "legacy migration marker is not a regular file"
    [[ "$(stat -c '%U:%G:%a:%h' -- "$LEGACY_MIGRATION_MARKER")" == "root:root:640:1" ]] \
        || die "legacy migration marker has unsafe ownership, mode, or link count"
    size="$(stat -c '%s' -- "$LEGACY_MIGRATION_MARKER")"
    [[ "$size" == "41" ]] || die "legacy migration marker has an invalid size"
    value="$(<"$LEGACY_MIGRATION_MARKER")"
    [[ "$value" == "$LEGACY_CURRENT_COMMIT" ]] \
        || die "legacy migration marker has unexpected content"
    LEGACY_MIGRATION_MARKER_EXISTED="1"
    LEGACY_MIGRATION_MARKER_VALUE="$value"
}

read_state_snapshot() {
    read_state_file_snapshot previous-release STATE_PREVIOUS_EXISTED STATE_PREVIOUS_BEFORE
    read_state_file_snapshot last-release STATE_LAST_EXISTED STATE_LAST_BEFORE
    read_migration_marker_snapshot
}

restore_state_snapshot() {
    if [[ "$STATE_PREVIOUS_EXISTED" == "1" ]]; then
        write_state_file previous-release "$STATE_PREVIOUS_BEFORE" || return 1
    else
        rm -f -- "$DEPLOY_ROOT/previous-release" || return 1
    fi
    if [[ "$STATE_LAST_EXISTED" == "1" ]]; then
        write_state_file last-release "$STATE_LAST_BEFORE" || return 1
    else
        rm -f -- "$DEPLOY_ROOT/last-release" || return 1
    fi
}

assert_state_file_matches_baseline() {
    local name="$1"
    local existed="$2"
    local expected="$3"
    local path="${DEPLOY_ROOT}/${name}"
    local size value
    if [[ "$existed" == "0" ]]; then
        [[ ! -e "$path" && ! -L "$path" ]] \
            || die "deployment state ${name} appeared during the operation"
        return 0
    fi
    [[ -f "$path" && ! -L "$path" \
        && "$(stat -c '%U:%G:%a:%h' -- "$path")" == "root:root:640:1" ]] \
        || die "deployment state ${name} changed type or metadata during the operation"
    size="$(stat -c '%s' -- "$path")"
    value="$(<"$path")"
    [[ "$value" == "$expected" && "$size" -eq $((${#expected} + 1)) ]] \
        || die "deployment state ${name} changed during the operation"
}

assert_state_snapshot_unchanged() {
    assert_state_file_matches_baseline previous-release "$STATE_PREVIOUS_EXISTED" "$STATE_PREVIOUS_BEFORE"
    assert_state_file_matches_baseline last-release "$STATE_LAST_EXISTED" "$STATE_LAST_BEFORE"
    if [[ "$LEGACY_MIGRATION_MARKER_EXISTED" == "0" ]]; then
        [[ ! -e "$LEGACY_MIGRATION_MARKER" && ! -L "$LEGACY_MIGRATION_MARKER" ]] \
            || die "legacy migration marker appeared during the operation"
    else
        [[ -f "$LEGACY_MIGRATION_MARKER" && ! -L "$LEGACY_MIGRATION_MARKER" \
            && "$(stat -c '%U:%G:%a:%h:%s' -- "$LEGACY_MIGRATION_MARKER")" == "root:root:640:1:41" \
            && "$(<"$LEGACY_MIGRATION_MARKER")" == "$LEGACY_MIGRATION_MARKER_VALUE" ]] \
            || die "legacy migration marker changed during the operation"
    fi
}

rollback_uncommitted_switch() {
    local actual_current rollback_basename rollback_previous
    if [[ "$SWITCH_STATE" == "armed" ]]; then
        case "$(current_target)" in
            "$SWITCH_TARGET") SWITCH_STATE="switched" ;;
            "$SWITCH_ORIGINAL_TARGET") SWITCH_STATE="not-switched"; return 0 ;;
            *) return 1 ;;
        esac
    fi
    [[ "$SWITCH_STATE" == "switched" ]] || return 0
    [[ -n "$SWITCH_ROLLBACK_TARGET" && -d "$SWITCH_ROLLBACK_TARGET" && ! -L "$SWITCH_ROLLBACK_TARGET" ]] || return 1
    log "restoring uncommitted production switch to $(basename -- "$SWITCH_ROLLBACK_TARGET")"
    actual_current="$(current_target)"
    if [[ "$actual_current" != "$SWITCH_ROLLBACK_TARGET" ]]; then
        [[ "$actual_current" == "$SWITCH_TARGET" ]] || return 1
        atomic_switch "$SWITCH_ROLLBACK_TARGET" || return 1
    fi
    systemctl restart "$SERVICE_NAME" || return 1
    health_gate || return 1
    verify_rollback_runtime "$SWITCH_ROLLBACK_TARGET" || return 1
    if [[ "$SWITCH_ROLLBACK_TARGET" == "$SWITCH_ORIGINAL_TARGET" ]]; then
        restore_state_snapshot || return 1
    else
        (assert_production_release "$SWITCH_ROLLBACK_TARGET") >/dev/null 2>&1 || return 1
        rollback_basename="$(basename -- "$SWITCH_ROLLBACK_TARGET")"
        [[ "$rollback_basename" =~ ^(git|rollback)-[0-9a-f]{7,40}$ ]] || return 1
        if [[ "$CURRENT_RELEASE_POLICY" == "legacy-writable" ]]; then
            rollback_previous="$rollback_basename"
        else
            rollback_previous="$STATE_PREVIOUS_BEFORE"
            [[ "$rollback_previous" =~ ^(git|rollback)-[0-9a-f]{7,40}$ ]] || return 1
        fi
        record_managed_current "$rollback_previous" "$rollback_basename" || return 1
    fi
    SWITCH_STATE="rolled-back"
}

attempt_automatic_rollback() {
    local context="$1"
    local attempt actual_current detail

    case "$SWITCH_STATE" in
        armed|switched) ;;
        *)
            AUTOMATIC_ROLLBACK_FAILED="0"
            AUTOMATIC_ROLLBACK_FAILURE_DETAIL=""
            return 0
            ;;
    esac

    for attempt in 1 2; do
        if rollback_uncommitted_switch; then
            AUTOMATIC_ROLLBACK_FAILED="0"
            AUTOMATIC_ROLLBACK_FAILURE_DETAIL=""
            return 0
        fi
        actual_current="$(current_target 2>/dev/null || true)"
        log "ERROR: automatic rollback attempt ${attempt}/2 failed during ${context}; switchState=${SWITCH_STATE}; actualCurrent=${actual_current:-unresolved}"
    done

    actual_current="$(current_target 2>/dev/null || true)"
    detail="automatic rollback attempts exhausted during ${context}; switchState=${SWITCH_STATE}; actualCurrent=${actual_current:-unresolved}; rollbackTarget=${SWITCH_ROLLBACK_TARGET:-unset}"
    AUTOMATIC_ROLLBACK_FAILED="1"
    AUTOMATIC_ROLLBACK_FAILURE_DETAIL="$detail"
    log "ERROR: ${detail}"
    return 1
}

mark_terminal_uncommitted_switch() {
    local actual_current detail
    case "$SWITCH_STATE" in
        armed|switched) ;;
        *) return 0 ;;
    esac
    actual_current="$(current_target 2>/dev/null || true)"
    detail="CRITICAL operation ended with an uncommitted production switch; switchState=${SWITCH_STATE}; actualCurrent=${actual_current:-unresolved}; rollbackTarget=${SWITCH_ROLLBACK_TARGET:-unset}"
    if [[ -n "$AUTOMATIC_ROLLBACK_FAILURE_DETAIL" ]]; then
        detail="${detail}; lastRollbackFailure=${AUTOMATIC_ROLLBACK_FAILURE_DETAIL}"
    fi
    AUTOMATIC_ROLLBACK_FAILED="1"
    if [[ "$ERROR_MESSAGE" != *"CRITICAL operation ended with an uncommitted production switch"* ]]; then
        if [[ -n "$ERROR_MESSAGE" ]]; then
            ERROR_MESSAGE="${ERROR_MESSAGE}; ${detail}"
        else
            ERROR_MESSAGE="$detail"
        fi
    fi
    log "$detail"
    return 1
}

on_signal() {
    local signal_name="$1"
    ERROR_MESSAGE="deployment interrupted by ${signal_name}"
    log "ERROR: ${ERROR_MESSAGE}"
    exit 128
}

on_exit() {
    local exit_code="$1"
    local evidence_ok="0"
    local error_before_terminal=""
    local evidence_failure_detail="failed to persist deployment evidence"
    local terminal_error_added="0"
    trap - EXIT
    trap '' HUP INT TERM
    set +e

    if [[ "$exit_code" -ne 0 && -z "$ERROR_MESSAGE" ]]; then
        ERROR_MESSAGE="operation failed with exit code ${exit_code}"
    fi

    if [[ "$SWITCH_STATE" == "armed" ]]; then
        exit_code=1
        [[ -n "$ERROR_MESSAGE" ]] || ERROR_MESSAGE="operation exited while the atomic switch was armed"
        if ! attempt_automatic_rollback "armed process exit"; then
            exit_code=1
        fi
    fi

    if [[ "$exit_code" -ne 0 && ( "$SWITCH_STATE" == "armed" || "$SWITCH_STATE" == "switched" ) ]]; then
        if ! attempt_automatic_rollback "failed operation exit"; then
            exit_code=1
        fi
    fi
    if ! cleanup_processing_job; then
        append_error_detail "failed to remove root-only processing data"
        exit_code=1
    fi
    if ! cleanup_transient_trees; then
        append_error_detail "failed to stop or remove transient validation or staging data"
        exit_code=1
    fi
    if [[ "$exit_code" -ne 0 && ( "$SWITCH_STATE" == "armed" || "$SWITCH_STATE" == "switched" ) ]]; then
        if ! attempt_automatic_rollback "post-cleanup failure"; then
            exit_code=1
        fi
    fi

    if [[ "$SWITCH_STATE" == "not-switched" ]] && production_baseline_captured \
        && ! (assert_state_snapshot_unchanged); then
        append_error_detail "deployment state changed before evidence commit"
        log "ERROR: deployment state changed before evidence commit"
        exit_code=1
    fi
    capture_after
    if [[ "$SWITCH_STATE" == "not-switched" ]] && production_baseline_captured; then
        if [[ "$CURRENT_AFTER" != "$CURRENT_BEFORE" || "$CURRENT_COMMIT_AFTER" != "$CURRENT_COMMIT_BEFORE" ]]; then
            append_error_detail "current release changed before evidence commit"
            log "ERROR: current release changed before evidence commit"
            exit_code=1
        elif [[ "$CURRENT_TREE_SHA256_AFTER" != "$CURRENT_TREE_SHA256_BEFORE" ]]; then
            append_error_detail "current release content changed before evidence commit"
            log "ERROR: current release content changed before evidence commit"
            exit_code=1
        elif [[ "$CURRENT_PORTABLE_SHA256_AFTER" != "$CURRENT_PORTABLE_SHA256_BEFORE" ]]; then
            append_error_detail "current release portable tree changed before evidence commit"
            log "ERROR: current release portable tree changed before evidence commit"
            exit_code=1
        elif [[ "$CURRENT_STATIC_SHA256_AFTER" != "$CURRENT_STATIC_SHA256_BEFORE" ]]; then
            append_error_detail "current release static tree changed before evidence commit"
            log "ERROR: current release static tree changed before evidence commit"
            exit_code=1
        elif [[ "$CURRENT_TREE_METADATA_SHA256_AFTER" != "$CURRENT_TREE_METADATA_SHA256_BEFORE" ]]; then
            append_error_detail "current release metadata changed before evidence commit"
            log "ERROR: current release metadata changed before evidence commit"
            exit_code=1
        elif [[ "$SERVICE_AFTER" != "$SERVICE_BEFORE" || "$PID_AFTER" != "$PID_BEFORE" \
            || "$RESTARTS_AFTER" != "$RESTARTS_BEFORE" ]]; then
            append_error_detail "production service changed before evidence commit"
            log "ERROR: production service changed before evidence commit"
            exit_code=1
        fi
    fi
    if production_baseline_captured; then
        if [[ "$NGINX_STATUS_AFTER" != "valid" ]]; then
            append_error_detail "nginx configuration changed before evidence commit"
            log "ERROR: nginx configuration changed before evidence commit"
            exit_code=1
        elif [[ -z "$HELPER_MANIFEST_SHA256_AFTER" || "$HELPER_MANIFEST_SHA256_AFTER" != "$HELPER_MANIFEST_SHA256_BEFORE" \
            || -z "$SCANNER_MANIFEST_SHA256_AFTER" || "$SCANNER_MANIFEST_SHA256_AFTER" != "$SCANNER_MANIFEST_SHA256_BEFORE" ]]; then
            append_error_detail "download manifest changed before evidence commit"
            log "ERROR: download manifest changed before evidence commit"
            exit_code=1
        elif [[ "$exit_code" -eq 0 && "$SWITCH_STATE" == "switched" \
            && ( "$CURRENT_AFTER" != "$SWITCH_TARGET" || "$SERVICE_AFTER" != "active" \
                || ! "$PID_AFTER" =~ ^[1-9][0-9]*$ || "$PID_AFTER" != "$HEALTH_GATE_PID" \
                || "$RESTARTS_AFTER" != "$RESTARTS_BEFORE" ) ]]; then
            append_error_detail "candidate runtime changed before evidence commit"
            log "ERROR: candidate runtime changed before evidence commit"
            exit_code=1
        fi
    fi
    if [[ "$exit_code" -ne 0 && ( "$SWITCH_STATE" == "armed" || "$SWITCH_STATE" == "switched" ) ]]; then
        if ! attempt_automatic_rollback "final invariant failure"; then
            exit_code=1
        fi
        capture_after
    fi
    if [[ "$exit_code" -ne 0 && ( "$SWITCH_STATE" == "armed" || "$SWITCH_STATE" == "switched" ) ]]; then
        error_before_terminal="$ERROR_MESSAGE"
        if ! mark_terminal_uncommitted_switch; then
            exit_code=1
        fi
        terminal_error_added="1"
    fi
    if [[ "$exit_code" -eq 0 ]]; then STATUS="success"; else STATUS="failed"; fi
    if write_evidence; then
        evidence_ok="1"
    else
        log "ERROR: failed to persist deployment evidence"
        if [[ "$terminal_error_added" == "1" ]]; then
            ERROR_MESSAGE="$error_before_terminal"
            terminal_error_added="0"
        fi
        if [[ -n "$ERROR_MESSAGE" ]]; then
            ERROR_MESSAGE="${ERROR_MESSAGE}; ${evidence_failure_detail}"
        else
            ERROR_MESSAGE="$evidence_failure_detail"
        fi
        STATUS="failed"
        exit_code=1
    fi

    if [[ "$evidence_ok" != "1" ]]; then
        if [[ "$SWITCH_STATE" == "armed" || "$SWITCH_STATE" == "switched" ]]; then
            if ! attempt_automatic_rollback "evidence persistence failure"; then
                exit_code=1
            fi
            capture_after
        fi
        if [[ "$SWITCH_STATE" == "armed" || "$SWITCH_STATE" == "switched" ]]; then
            if ! mark_terminal_uncommitted_switch; then
                exit_code=1
            fi
            terminal_error_added="1"
        fi
        STATUS="failed"
        if write_evidence; then
            evidence_ok="1"
        else
            log "CRITICAL: failed to persist deployment evidence after the recovery attempt"
        fi
    fi

    if [[ "$exit_code" -eq 0 && "$evidence_ok" == "1" && "$SWITCH_STATE" == "switched" ]]; then
        SWITCH_STATE="committed"
    fi

    if [[ -n "$EVIDENCE_PATH" && -f "$EVIDENCE_PATH" ]]; then
        cat -- "$EVIDENCE_PATH" || true
    fi
    exit "$exit_code"
}

assert_validation_principal() {
    local expected_gid passwd_record account_name account_password account_uid account_gid
    local account_gecos account_home account_shell password_status

    expected_gid="$(getent group "$VALIDATION_GROUP" | awk -F: 'NR == 1 { print $3 }')"
    [[ "$expected_gid" =~ ^[1-9][0-9]*$ ]] || die "validation group ${VALIDATION_GROUP} is missing or invalid"
    passwd_record="$(getent passwd "$VALIDATION_USER")" || die "validation account ${VALIDATION_USER} is missing"
    IFS=: read -r account_name account_password account_uid account_gid account_gecos account_home account_shell <<<"$passwd_record"
    [[ "$account_name" == "$VALIDATION_USER" && "$account_uid" =~ ^[1-9][0-9]*$ ]] \
        || die "validation account identity is invalid"
    [[ "$account_gid" == "$expected_gid" && "$(id -G "$VALIDATION_USER")" == "$expected_gid" ]] \
        || die "validation account must have only its dedicated primary group"
    [[ "$account_home" == "$VALIDATION_ACCOUNT_HOME" && "$account_shell" == "/usr/sbin/nologin" ]] \
        || die "validation account must use /nonexistent and /usr/sbin/nologin"
    password_status="$(passwd --status "$VALIDATION_USER" 2>/dev/null | awk 'NR == 1 { print $2 }')"
    password_status_is_locked "$password_status" \
        || die "validation account password is not locked"
    [[ ! -e "$VALIDATION_ACCOUNT_HOME" && ! -L "$VALIDATION_ACCOUNT_HOME" ]] \
        || die "validation account home path must not exist"
    if [[ -e /var/lib/zzz-calculator || -L /var/lib/zzz-calculator ]]; then
        runuser -u "$VALIDATION_USER" -- test ! -r /var/lib/zzz-calculator \
            || die "validation account can read the production StateDirectory"
        runuser -u "$VALIDATION_USER" -- test ! -w /var/lib/zzz-calculator \
            || die "validation account can write the production StateDirectory"
        runuser -u "$VALIDATION_USER" -- test ! -x /var/lib/zzz-calculator \
            || die "validation account can traverse the production StateDirectory"
    fi
    VALIDATION_UID="$account_uid"
    VALIDATION_GID="$expected_gid"
}

require_root_and_layout() {
    local tar_version required_absolute_command
    [[ "$(id -u)" -eq 0 ]] || die "this program must run as root through the restricted sudo rule"
    [[ -d "$DEPLOY_ROOT" && ! -L "$DEPLOY_ROOT" ]] || die "deployment root is not initialized"
    [[ "$(stat -c '%U:%G:%a' -- "$DEPLOY_ROOT")" == "root:root:755" ]] || die "deployment root must be root-owned mode 0755"
    [[ -d "$INCOMING_DIR" && ! -L "$INCOMING_DIR" ]] || die "incoming directory is not initialized"
    [[ "$(stat -c '%U:%G:%a' -- "$INCOMING_DIR")" == "root:zzzdeploy:770" ]] || die "incoming directory must be root:zzzdeploy mode 0770"
    [[ -d "$PROCESSING_DIR" && ! -L "$PROCESSING_DIR" ]] || die "processing directory is not initialized"
    [[ "$(stat -c '%U:%G:%a' -- "$PROCESSING_DIR")" == "root:root:700" ]] || die "processing directory must be root-owned mode 0700"
    [[ -d "$HISTORY_DIR" && ! -L "$HISTORY_DIR" && -w "$HISTORY_DIR" ]] || die "history directory is not initialized or writable"
    [[ "$(stat -c '%U:%G:%a' -- "$HISTORY_DIR")" == "root:root:750" ]] || die "history directory must be root-owned mode 0750"
    [[ -d "$VALIDATION_DIR" && ! -L "$VALIDATION_DIR" ]] || die "validation directory is not initialized"
    [[ "$(stat -c '%U:%G:%a' -- "$VALIDATION_DIR")" == "root:root:750" ]] || die "validation directory must be root-owned mode 0750"
    [[ -d "$RELEASE_ROOT" && ! -L "$RELEASE_ROOT" ]] || die "release root is missing"
    [[ "$(stat -c '%U:%G:%a' -- "$RELEASE_ROOT")" == "root:root:755" ]] || die "release root must be root-owned mode 0755"
    command -v flock >/dev/null || die "flock is required"
    command -v find >/dev/null || die "find is required"
    command -v head >/dev/null || die "head is required"
    command -v sha256sum >/dev/null || die "sha256sum is required"
    command -v tar >/dev/null || die "tar is required"
    tar_version="$(tar --version 2>/dev/null)" || die "cannot inspect tar version"
    [[ "$tar_version" == tar\ \(GNU\ tar\)* ]] || die "GNU tar is required"
    command -v base64 >/dev/null || die "base64 is required"
    command -v cmp >/dev/null || die "cmp is required"
    command -v curl >/dev/null || die "curl is required"
    command -v jq >/dev/null || die "jq is required"
    command -v nginx >/dev/null || die "nginx is required"
    command -v journalctl >/dev/null || die "journalctl is required"
    command -v ipcmk >/dev/null || die "ipcmk is required"
    command -v ipcrm >/dev/null || die "ipcrm is required"
    command -v mkdir >/dev/null || die "mkdir is required"
    command -v mountpoint >/dev/null || die "mountpoint is required"
    command -v runuser >/dev/null || die "runuser is required"
    command -v setarch >/dev/null || die "setarch is required"
    command -v sort >/dev/null || die "sort is required"
    command -v uname >/dev/null || die "uname is required"
    command -v realpath >/dev/null || die "realpath is required"
    command -v systemd-run >/dev/null || die "systemd-run is required"
    for required_absolute_command in \
        /bin/bash /usr/bin/base64 /usr/bin/cmp /usr/bin/cp /usr/bin/df \
        /usr/bin/env /usr/bin/ipcmk /usr/bin/ipcrm /usr/bin/journalctl \
        /usr/bin/mkdir /usr/bin/node /usr/bin/setarch /usr/bin/stat /usr/bin/systemctl \
        /usr/bin/systemd-run /usr/bin/tail /usr/bin/timeout \
        /usr/bin/tr /usr/bin/true /usr/bin/uname; do
        [[ -x "$required_absolute_command" ]] \
            || die "${required_absolute_command} is required"
    done
    [[ -f "$VALIDATION_WORKER" && ! -L "$VALIDATION_WORKER" \
        && "$(stat -c '%U:%G:%a' -- "$VALIDATION_WORKER")" == "root:root:555" ]] \
        || die "validation worker must be root-owned mode 0555"
    assert_validation_principal
    runuser -u "$VALIDATION_USER" -- test -x "$VALIDATION_WORKER" \
        || die "validation account cannot execute the validation worker"
    runuser -u "$VALIDATION_USER" -- test ! -w "$VALIDATION_WORKER" \
        || die "validation account can write the validation worker"
}

preflight_evidence_storage() {
    local probe previous_status previous_error
    probe="$(mktemp "${HISTORY_DIR}/.write-probe.XXXXXXXX")" || die "history directory cannot create evidence"
    previous_status="$STATUS"
    previous_error="$ERROR_MESSAGE"
    STATUS="failed"
    ERROR_MESSAGE="evidence preflight probe"
    if ! emit_evidence_json "not-switched" "$STARTED_AT" >"$probe" \
        || ! validate_evidence_json "$probe"; then
        STATUS="$previous_status"
        ERROR_MESSAGE="$previous_error"
        rm -f -- "$probe"
        die "history directory cannot render and validate evidence"
    fi
    STATUS="$previous_status"
    ERROR_MESSAGE="$previous_error"
    chmod 0600 "$probe" || { rm -f -- "$probe"; die "history evidence permissions cannot be set"; }
    rm -f -- "$probe" || die "history evidence probe cannot be removed"
}

acquire_lock() {
    if [[ -e "$LOCK_FILE" || -L "$LOCK_FILE" ]]; then
        [[ -f "$LOCK_FILE" && ! -L "$LOCK_FILE" \
            && "$(stat -c '%U:%G:%h' -- "$LOCK_FILE")" == "root:root:1" ]] \
            || die "deployment lock is not a safe root-owned regular file"
    fi
    exec 9>"$LOCK_FILE"
    [[ "$(stat -Lc '%U:%G:%h' -- "/proc/$$/fd/9")" == "root:root:1" ]] \
        || die "deployment lock descriptor is not a safe root-owned regular file"
    flock -n 9 || die "another deployment operation is running"
}

validate_sha256() {
    [[ "${1:-}" =~ ^[0-9a-f]{64}$ ]] || die "expected SHA-256 must be 64 lowercase hexadecimal characters"
}

validate_commit() {
    [[ "${1:-}" =~ ^[0-9a-f]{40}$ ]] || die "expected commit must be 40 lowercase hexadecimal characters"
}

validate_artifact_basename() {
    [[ "${1:-}" =~ ^zzz-calculator-server-[0-9a-f]{7,40}\.tar\.gz$ ]] || die "invalid artifact basename"
}

parse_artifact_options() {
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            --artifact)
                [[ "$#" -ge 2 ]] || die "--artifact requires a value"
                ARTIFACT_BASENAME="$2"
                shift 2
                ;;
            --evidence)
                [[ "$#" -ge 2 ]] || die "--evidence requires a value"
                EVIDENCE_PATH_INPUT="$2"
                shift 2
                ;;
            --expected-sha)
                [[ "$#" -ge 2 ]] || die "--expected-sha requires a value"
                EXPECTED_SHA256="$2"
                shift 2
                ;;
            --expected-commit)
                [[ "$#" -ge 2 ]] || die "--expected-commit requires a value"
                EXPECTED_COMMIT="$2"
                shift 2
                ;;
            --commit)
                [[ "$#" -ge 2 ]] || die "--commit requires a value"
                EXPECTED_COMMIT="$2"
                shift 2
                ;;
            *)
                die "unsupported option: $1"
                ;;
        esac
    done

    if [[ -n "$ARTIFACT_BASENAME" ]]; then
        if [[ "$ARTIFACT_BASENAME" == "$INCOMING_DIR/"* ]]; then
            ARTIFACT_BASENAME="${ARTIFACT_BASENAME##*/}"
        fi
        ARTIFACT_BASENAME="${ARTIFACT_BASENAME%.part}"
        validate_artifact_basename "$ARTIFACT_BASENAME"
    else
        local -a candidates=()
        mapfile -t candidates < <(find "$INCOMING_DIR" -mindepth 1 -maxdepth 1 -type f -name 'zzz-calculator-server-*.tar.gz' -printf '%f\n' | LC_ALL=C sort)
        [[ "${#candidates[@]}" -eq 1 ]] || die "--artifact is required unless incoming contains exactly one server artifact"
        ARTIFACT_BASENAME="${candidates[0]}"
        validate_artifact_basename "$ARTIFACT_BASENAME"
    fi

    [[ -z "$EXPECTED_SHA256" ]] || validate_sha256 "$EXPECTED_SHA256"
    [[ -z "$EXPECTED_COMMIT" ]] || validate_commit "$EXPECTED_COMMIT"
    ARTIFACT_PATH="${INCOMING_DIR}/${ARTIFACT_BASENAME}"
    if [[ -f "${INCOMING_DIR}/${ARTIFACT_BASENAME}.part" && ! -e "$ARTIFACT_PATH" ]]; then
        ARTIFACT_PATH="${INCOMING_DIR}/${ARTIFACT_BASENAME}.part"
    fi
    [[ -f "$ARTIFACT_PATH" && ! -L "$ARTIFACT_PATH" ]] || die "artifact is not a regular file in incoming"

    if [[ -n "$EVIDENCE_PATH_INPUT" ]]; then
        if [[ "$EVIDENCE_PATH_INPUT" == "$INCOMING_DIR/"* ]]; then
            EVIDENCE_PATH_INPUT="${EVIDENCE_PATH_INPUT##*/}"
        fi
        EVIDENCE_PATH_INPUT="${EVIDENCE_PATH_INPUT%.part}"
        [[ "$EVIDENCE_PATH_INPUT" =~ ^zzz-calculator-server-[0-9a-f]{7,40}\.evidence\.json$ ]] || die "invalid evidence basename"
        EVIDENCE_PATH_INPUT="${INCOMING_DIR}/${EVIDENCE_PATH_INPUT}"
        if [[ ! -f "$EVIDENCE_PATH_INPUT" && -f "${EVIDENCE_PATH_INPUT}.part" ]]; then
            EVIDENCE_PATH_INPUT="${EVIDENCE_PATH_INPUT}.part"
        fi
        [[ -f "$EVIDENCE_PATH_INPUT" && ! -L "$EVIDENCE_PATH_INPUT" ]] || die "evidence is not a regular file in incoming"
        command -v jq >/dev/null || die "jq is required when evidence is supplied"
    fi
}

claim_incoming_file() {
    local source="$1"
    local basename untrusted sealed_tmp target max_bytes source_size sealed_size

    [[ "$source" == "$INCOMING_DIR/"* ]] || die "upload source is outside incoming"
    basename="${source##*/}"
    [[ "$basename" != "." && "$basename" != ".." && "$basename" != */* ]] || die "upload basename is invalid"
    case "$basename" in
        zzz-calculator-server-*.tar.gz|zzz-calculator-server-*.tar.gz.part) max_bytes="$MAX_COMPRESSED_BYTES" ;;
        zzz-calculator-server-*.evidence.json|zzz-calculator-server-*.evidence.json.part) max_bytes="$MAX_EVIDENCE_BYTES" ;;
        *) die "uploaded file type is not allowed" ;;
    esac
    source_size="$(stat -c '%s' -- "$source")"
    [[ "$source_size" =~ ^[1-9][0-9]*$ ]] || die "uploaded file is empty or has an invalid size"
    (( source_size <= max_bytes )) || die "uploaded file exceeds its size limit"
    untrusted="${PROCESSING_JOB_DIR}/.untrusted-${basename}"
    sealed_tmp="${PROCESSING_JOB_DIR}/.sealed-${basename}.tmp"
    target="${PROCESSING_JOB_DIR}/${basename}"
    [[ ! -e "$untrusted" && ! -L "$untrusted" && ! -e "$sealed_tmp" && ! -L "$sealed_tmp" && ! -e "$target" && ! -L "$target" ]] || die "claimed upload target already exists"
    [[ "$(stat -c '%d' -- "$source")" == "$(stat -c '%d' -- "$PROCESSING_JOB_DIR")" ]] || die "incoming and processing must share a filesystem"
    mv -T -- "$source" "$untrusted" || die "failed to claim uploaded file"
    [[ -f "$untrusted" && ! -L "$untrusted" ]] || die "claimed upload is not a regular file"
    [[ "$(stat -c '%h' -- "$untrusted")" == "1" ]] || die "claimed upload must not be hard-linked"
    source_size="$(stat -c '%s' -- "$untrusted")"
    (( source_size > 0 && source_size <= max_bytes )) || die "claimed upload exceeds its size limit"

    # Renaming and chowning do not revoke a writer's already-open descriptor.
    # Copy to a new inode under a kernel file-size limit, then validate and
    # extract only that sealed copy.
    ( ulimit -f "$((max_bytes / 1024))"; cp --reflink=never -- "$untrusted" "$sealed_tmp" ) \
        || die "failed to seal uploaded file within its size limit"
    [[ -f "$sealed_tmp" && ! -L "$sealed_tmp" && "$(stat -c '%h' -- "$sealed_tmp")" == "1" ]] || die "sealed upload is not a private regular file"
    sealed_size="$(stat -c '%s' -- "$sealed_tmp")"
    [[ "$sealed_size" == "$source_size" ]] || die "uploaded file changed while it was being sealed"
    (( sealed_size <= max_bytes )) || die "sealed upload exceeds its size limit"
    chown root:root "$sealed_tmp"
    chmod 0640 "$sealed_tmp"
    mv -T -- "$sealed_tmp" "$target"
    rm -f -- "$untrusted"
    CLAIMED_PATH="$target"
}

prepare_processing_job() {
    if [[ -n "$PROCESSING_JOB_DIR" ]]; then
        [[ "$PROCESSING_JOB_DIR" == "$PROCESSING_DIR/job."* \
            && -d "$PROCESSING_JOB_DIR" && ! -L "$PROCESSING_JOB_DIR" \
            && "$(stat -c '%U:%G:%a' -- "$PROCESSING_JOB_DIR")" == "root:root:700" ]] \
            || die "root-only processing job is invalid"
        return 0
    fi
    PROCESSING_JOB_DIR="$(mktemp -d "${PROCESSING_DIR}/job.XXXXXXXX")"
    chown root:root "$PROCESSING_JOB_DIR"
    chmod 0700 "$PROCESSING_JOB_DIR"
}

claim_incoming_inputs() {
    local source

    prepare_processing_job

    source="$ARTIFACT_PATH"
    claim_incoming_file "$source"
    ARTIFACT_PATH="$CLAIMED_PATH"
    if [[ -n "$EVIDENCE_PATH_INPUT" ]]; then
        source="$EVIDENCE_PATH_INPUT"
        claim_incoming_file "$source"
        EVIDENCE_PATH_INPUT="$CLAIMED_PATH"
    fi
    CLAIMED_PATH=""
}

validate_archive_listing() {
    local listing_file verbose_file entry normalized type normalized_file duplicates expanded
    listing_file="$(mktemp "${PROCESSING_JOB_DIR}/.archive-list.XXXXXXXX")"
    verbose_file="$(mktemp "${PROCESSING_JOB_DIR}/.archive-verbose.XXXXXXXX")"
    normalized_file="$(mktemp "${PROCESSING_JOB_DIR}/.archive-normalized.XXXXXXXX")"
    LC_ALL=C tar --quoting-style=escape -tzf "$ARTIFACT_PATH" >"$listing_file" 2>/dev/null \
        || die "artifact is not a readable gzip tar archive"
    [[ -s "$listing_file" ]] || die "artifact archive is empty"
    ARCHIVE_ENTRY_COUNT="$(wc -l <"$listing_file" | tr -d '[:space:]')"
    [[ "$ARCHIVE_ENTRY_COUNT" =~ ^[0-9]+$ ]] || die "cannot count archive entries"
    (( ARCHIVE_ENTRY_COUNT <= MAX_ARCHIVE_ENTRIES )) || die "artifact exceeds ${MAX_ARCHIVE_ENTRIES} entries"

    while IFS= read -r entry; do
        [[ -n "$entry" ]] || continue
        normalized="$entry"
        while [[ "$normalized" == ./* ]]; do
            normalized="${normalized#./}"
        done
        while [[ "$normalized" == */ ]]; do
            normalized="${normalized%/}"
        done
        [[ -n "$normalized" ]] || continue
        if [[ "$normalized" == /* || "$normalized" == *//* \
            || "$normalized" == "." || "$normalized" == */./* || "$normalized" == */. \
            || "$normalized" == ".." || "$normalized" == ../* || "$normalized" == */../* || "$normalized" == */.. ]]; then
            die "unsafe archive path: ${entry}"
        fi
        printf '%s\n' "$normalized" >>"$normalized_file"
    done <"$listing_file"
    duplicates="$(LC_ALL=C sort "$normalized_file" | uniq -d)"
    [[ -z "$duplicates" ]] || die "archive contains duplicate paths"

    LC_ALL=C tar --numeric-owner --quoting-style=escape -tvzf "$ARTIFACT_PATH" >"$verbose_file" 2>/dev/null \
        || die "cannot inspect archive entry types"
    while IFS= read -r entry; do
        [[ -n "$entry" ]] || continue
        type="${entry:0:1}"
        case "$type" in
            -|d) ;;
            *) die "archive contains a link or special entry" ;;
        esac
    done <"$verbose_file"
    expanded="$(awk '
        $3 !~ /^[0-9]+$/ { exit 2 }
        { total += $3; if (total > 1073741824) exit 3 }
        END { if (total <= 1073741824) printf "%.0f", total }
    ' "$verbose_file")" || die "artifact expanded size is invalid or exceeds 1 GiB"
    [[ "$expanded" =~ ^[0-9]+$ ]] || die "artifact expanded size is invalid"
    ARCHIVE_EXPANDED_BYTES="$expanded"
    (( ARCHIVE_EXPANDED_BYTES <= MAX_EXPANDED_BYTES )) || die "artifact expanded size exceeds 1 GiB"
}

tree_usage() {
    local root="$1"
    local entries files bytes
    entries="$(find "$root" -xdev -print | wc -l | tr -d '[:space:]')"
    files="$(find "$root" -xdev -type f -print | wc -l | tr -d '[:space:]')"
    bytes="$(find "$root" -xdev -type f -printf '%s\n' \
        | awk '{ total += $1 } END { printf "%.0f", total + 0 }')"
    printf '%s:%s:%s' "$entries" "$files" "$bytes"
}

tree_size_bytes() {
    local root="$1"
    find "$root" -xdev -type f -printf '%s\n' | awk '{ total += $1 } END { printf "%.0f", total + 0 }'
}

assert_snapshot_capacity() {
    local destination="$1"
    local required_bytes required_inodes available_bytes available_inodes
    required_bytes="$((CURRENT_TREE_BYTES + MIN_DISK_HEADROOM_BYTES))"
    required_inodes="$((CURRENT_TREE_ENTRY_COUNT + MIN_DISK_HEADROOM_INODES))"
    available_bytes="$(df -PB1 -- "$destination" | awk 'NR == 2 { print $4 }')"
    available_inodes="$(df -Pi -- "$destination" | awk 'NR == 2 { print $4 }')"
    [[ "$available_bytes" =~ ^[0-9]+$ && "$available_inodes" =~ ^[0-9]+$ ]] \
        || die "cannot calculate sealed snapshot storage headroom"
    (( available_bytes >= required_bytes )) || die "insufficient disk headroom for sealed current snapshot"
    (( available_inodes >= required_inodes )) || die "insufficient inode headroom for sealed current snapshot"
}

check_disk_headroom() {
    local destination="$1"
    local processing_device validation_device release_device
    processing_device="$(stat -c '%d' -- "$PROCESSING_DIR")"
    validation_device="$(stat -c '%d' -- "$VALIDATION_DIR")"
    release_device="$(stat -c '%d' -- "$RELEASE_ROOT")"
    [[ "$processing_device" == "$validation_device" && "$validation_device" == "$release_device" ]] \
        || die "processing, validation, and release roots must share one filesystem"
    DISK_REQUIRED_BYTES="$((4 * ARCHIVE_EXPANDED_BYTES + 6 * CURRENT_TREE_BYTES + ARTIFACT_SIZE_BYTES + MIN_DISK_HEADROOM_BYTES))"
    DISK_REQUIRED_INODES="$((4 * ARCHIVE_ENTRY_COUNT + 6 * CURRENT_TREE_ENTRY_COUNT + MIN_DISK_HEADROOM_INODES))"
    DISK_AVAILABLE_BYTES="$(df -PB1 -- "$destination" | awk 'NR == 2 { print $4 }')"
    DISK_AVAILABLE_INODES="$(df -Pi -- "$destination" | awk 'NR == 2 { print $4 }')"
    [[ "$DISK_AVAILABLE_BYTES" =~ ^[0-9]+$ && "$DISK_AVAILABLE_INODES" =~ ^[0-9]+$ ]] \
        || die "cannot calculate deployment storage headroom"
    (( DISK_AVAILABLE_BYTES >= DISK_REQUIRED_BYTES )) \
        || die "insufficient disk headroom for candidate, rollback, and validation trees"
    (( DISK_AVAILABLE_INODES >= DISK_REQUIRED_INODES )) \
        || die "insufficient inode headroom for candidate, rollback, and validation trees"
}

tree_sha256() {
    local root="$1"
    local relative file_sha file_size
    (
        cd "$root"
        while IFS= read -r -d '' relative; do
            relative="${relative#./}"
            file_sha="$(sha256sum -- "$relative" | awk '{print $1}')"
            file_size="$(stat -c '%s' -- "$relative")"
            printf '%s\0%s\0%s\n' "$relative" "$file_size" "$file_sha"
        done < <(find . -xdev -type f -print0 | LC_ALL=C sort -z)
    ) | sha256sum | awk '{print $1}'
}

portable_tree_sha256() {
    local root="$1"
    local mode="${2:-full}"
    local relative entry_type entry_mode entry_size entry_sha
    [[ "$mode" == "full" || "$mode" == "static" ]] || return 1
    (
        cd "$root"
        if [[ "$mode" == "static" ]]; then
            while IFS= read -r -d '' relative; do
                relative="${relative#./}"
                [[ -n "$relative" ]] || relative='.'
                if [[ -d "$relative" ]]; then
                    entry_type='d'; entry_size='0'; entry_sha='-'
                else
                    entry_type='f'
                    entry_size="$(stat -c '%s' -- "$relative")"
                    entry_sha="$(sha256sum -- "$relative" | awk '{print $1}')"
                fi
                entry_mode="$(stat -c '%a' -- "$relative")"
                printf '%s\0%s\0%s\0%s\0%s\n' \
                    "$relative" "$entry_type" "$entry_mode" "$entry_size" "$entry_sha"
            done < <(find . -xdev \
                \( -path './data/user_drive_discs.json' \
                    -o -path './data/scan-telemetry' \
                    -o -path './data/scan-telemetry/*' \) -prune \
                -o \( -type d -o -type f \) -print0 | LC_ALL=C sort -z)
        else
            while IFS= read -r -d '' relative; do
                relative="${relative#./}"
                [[ -n "$relative" ]] || relative='.'
                if [[ -d "$relative" ]]; then
                    entry_type='d'; entry_size='0'; entry_sha='-'
                else
                    entry_type='f'
                    entry_size="$(stat -c '%s' -- "$relative")"
                    entry_sha="$(sha256sum -- "$relative" | awk '{print $1}')"
                fi
                entry_mode="$(stat -c '%a' -- "$relative")"
                printf '%s\0%s\0%s\0%s\0%s\n' \
                    "$relative" "$entry_type" "$entry_mode" "$entry_size" "$entry_sha"
            done < <(find . -xdev \( -type d -o -type f \) -print0 | LC_ALL=C sort -z)
        fi
    ) | sha256sum | awk '{print $1}'
}

tree_metadata_sha256() {
    local root="$1"
    local relative
    (
        cd "$root"
        while IFS= read -r -d '' relative; do
            relative="${relative#./}"
            [[ -n "$relative" ]] || relative='.'
            printf '%s\0' "$relative"
            stat -c '%F:%d:%i:%u:%g:%a:%h:%s:%Y:%Z' -- "$relative"
        done < <(find . -xdev -print0 | LC_ALL=C sort -z)
    ) | sha256sum | awk '{print $1}'
}

extract_and_validate() {
    local destination="$1"
    local artifact_commit_prefix evidence_basename

    ARTIFACT_SIZE_BYTES="$(stat -c '%s' -- "$ARTIFACT_PATH")"
    [[ "$ARTIFACT_SIZE_BYTES" =~ ^[1-9][0-9]*$ ]] || die "artifact is empty"
    (( ARTIFACT_SIZE_BYTES <= MAX_COMPRESSED_BYTES )) || die "artifact compressed size exceeds 256 MiB"
    ARTIFACT_SHA256="$(sha256sum -- "$ARTIFACT_PATH" | awk '{print $1}')"
    if [[ -n "$EVIDENCE_PATH_INPUT" ]]; then
        local evidence_size evidence_sha evidence_commit evidence_archive
        evidence_size="$(jq -er '.artifact.size' -- "$EVIDENCE_PATH_INPUT")" || die "evidence has no artifact size"
        evidence_sha="$(jq -er '.artifact.sha256' -- "$EVIDENCE_PATH_INPUT")" || die "evidence has no artifact SHA-256"
        evidence_commit="$(jq -er '.commit' -- "$EVIDENCE_PATH_INPUT")" || die "evidence has no commit"
        jq -e '.artifact.path as $path | ($path | type == "string") and ($path | explode | all(. >= 32 and . != 127))' \
            -- "$EVIDENCE_PATH_INPUT" >/dev/null || die "evidence artifact path contains control characters"
        evidence_archive="$(jq -er '.artifact.path' -- "$EVIDENCE_PATH_INPUT")" || die "evidence has no artifact path"
        [[ "$evidence_size" =~ ^[0-9]+$ ]] || die "evidence artifact size is invalid"
        validate_sha256 "$evidence_sha"
        validate_commit "$evidence_commit"
        [[ "$evidence_size" == "$ARTIFACT_SIZE_BYTES" ]] || die "artifact size does not match evidence"
        [[ "$evidence_sha" == "$ARTIFACT_SHA256" ]] || die "artifact SHA-256 does not match evidence"
        [[ "${evidence_archive##*/}" == "$ARTIFACT_BASENAME" ]] || die "artifact basename does not match evidence"
        evidence_basename="${EVIDENCE_PATH_INPUT##*/}"
        evidence_basename="${evidence_basename%.part}"
        [[ "${evidence_basename%.evidence.json}" == "${ARTIFACT_BASENAME%.tar.gz}" ]] \
            || die "evidence filename does not match the artifact filename"
        if [[ -z "$EXPECTED_SHA256" ]]; then EXPECTED_SHA256="$evidence_sha"; fi
        if [[ -z "$EXPECTED_COMMIT" ]]; then EXPECTED_COMMIT="$evidence_commit"; fi
    fi
    if [[ -n "$EXPECTED_SHA256" && "$ARTIFACT_SHA256" != "$EXPECTED_SHA256" ]]; then
        die "artifact SHA-256 does not match the approved value"
    fi

    validate_archive_listing
    check_disk_headroom "$destination"
    tar --no-same-owner --no-same-permissions --no-acls --no-xattrs -xzf "$ARTIFACT_PATH" -C "$destination"
    [[ "$(tree_size_bytes "$destination")" -le "$MAX_EXPANDED_BYTES" ]] || die "extracted artifact exceeds 1 GiB"
    [[ -f "$destination/.deployed-commit" && ! -L "$destination/.deployed-commit" ]] || die "artifact is missing .deployed-commit"
    DEPLOYED_COMMIT="$(<"$destination/.deployed-commit")"
    validate_commit "$DEPLOYED_COMMIT"
    artifact_commit_prefix="${ARTIFACT_BASENAME#zzz-calculator-server-}"
    artifact_commit_prefix="${artifact_commit_prefix%.tar.gz}"
    [[ "$DEPLOYED_COMMIT" == "$artifact_commit_prefix"* ]] \
        || die "artifact filename commit prefix does not match .deployed-commit"
    if [[ -n "$EXPECTED_COMMIT" && "$DEPLOYED_COMMIT" != "$EXPECTED_COMMIT" ]]; then
        die ".deployed-commit does not match the approved commit"
    fi

    if [[ "$ARTIFACT_PATH" == *.part && "$FINALIZE_UPLOAD" == "1" ]]; then
        local final_artifact="${ARTIFACT_PATH%.part}"
        if [[ -e "$final_artifact" || -L "$final_artifact" ]]; then
            [[ -f "$final_artifact" && ! -L "$final_artifact" ]] || die "final artifact path is occupied"
            [[ "$(sha256sum -- "$final_artifact" | awk '{print $1}')" == "$ARTIFACT_SHA256" ]] || die "final artifact differs from uploaded part"
        else
            mv -T -- "$ARTIFACT_PATH" "$final_artifact"
        fi
        ARTIFACT_PATH="$final_artifact"
    fi

    RELEASE_BASENAME="git-${DEPLOYED_COMMIT:0:12}"
    RELEASE_TREE_SHA256="$(tree_sha256 "$destination")"
    [[ -d "$destination/dist/pages" ]] || die "artifact is missing dist/pages"
    [[ -f "$destination/backend/server.js" ]] || die "artifact is missing backend/server.js"
    [[ -f "$destination/dist/pages/index.html" ]] || die "artifact is missing dist/pages/index.html"
    PAGES_TREE_SHA256="$(tree_sha256 "$destination/dist/pages")"
}

assert_no_symlinks() {
    local root="$1"
    if find "$root" -type l -print -quit | grep -q .; then
        die "resource tree contains a symbolic link: ${root}"
    fi
}

merge_missing_files() {
    local source_root="$1"
    local destination_root="$2"
    local source relative destination

    if [[ ! -e "$source_root" && ! -L "$source_root" ]]; then
        return 0
    fi
    [[ -d "$source_root" && ! -L "$source_root" ]] || die "static resource tree is not a directory: ${source_root}"
    install -d -m 0755 -- "$destination_root"
    [[ -d "$destination_root" && ! -L "$destination_root" ]] || die "static resource destination is not a directory: ${destination_root}"
    assert_no_symlinks "$source_root"
    assert_no_symlinks "$destination_root"
    while IFS= read -r -d '' source; do
        relative="${source#"$source_root"/}"
        destination="${destination_root}/${relative}"
        if [[ -e "$destination" || -L "$destination" ]]; then
            [[ -f "$destination" && ! -L "$destination" ]] || die "static resource type conflict: ${relative}"
            cmp -s -- "$source" "$destination" || die "static resource content conflict: ${relative}"
        else
            install -d -m 0755 -- "$(dirname "$destination")"
            cp -a -- "$source" "$destination"
        fi
    done < <(find "$source_root" -type f -print0 | LC_ALL=C sort -z)
}

merge_compatible_resources() {
    local previous="$1"
    local candidate="$2"
    local rollback="$3"
    local relative_tree
    local -a resource_trees=("dist/pages/static/app" "dist/pages/assets")

    for relative_tree in "${resource_trees[@]}"; do
        if [[ ! -e "$previous/$relative_tree" && ! -L "$previous/$relative_tree" \
            && ! -e "$candidate/$relative_tree" && ! -L "$candidate/$relative_tree" ]]; then
            continue
        fi
        [[ ! -e "$previous/$relative_tree" || -d "$previous/$relative_tree" ]] || die "previous release has invalid ${relative_tree}"
        [[ ! -L "$previous/$relative_tree" ]] || die "previous release has symbolic-link ${relative_tree}"
        [[ ! -e "$candidate/$relative_tree" || -d "$candidate/$relative_tree" ]] || die "candidate release has invalid ${relative_tree}"
        [[ ! -L "$candidate/$relative_tree" ]] || die "candidate release has symbolic-link ${relative_tree}"
        install -d -m 0755 -- "$candidate/$relative_tree" "$rollback/$relative_tree"
        merge_missing_files "$previous/$relative_tree" "$candidate/$relative_tree"
        merge_missing_files "$candidate/$relative_tree" "$rollback/$relative_tree"
    done
}

merge_existing_release_resources() {
    local source_root="$1"
    local destination_root="$2"
    local relative_tree

    for relative_tree in "dist/pages/static/app" "dist/pages/assets"; do
        if [[ ! -e "$source_root/$relative_tree" && ! -L "$source_root/$relative_tree" \
            && ! -e "$destination_root/$relative_tree" && ! -L "$destination_root/$relative_tree" ]]; then
            continue
        fi
        [[ ! -e "$source_root/$relative_tree" || -d "$source_root/$relative_tree" ]] || die "existing release has invalid ${relative_tree}"
        [[ ! -L "$source_root/$relative_tree" ]] || die "existing release has symbolic-link ${relative_tree}"
        install -d -m 0755 -- "$destination_root/$relative_tree"
        merge_missing_files "$source_root/$relative_tree" "$destination_root/$relative_tree"
    done
}

prepare_immutable_release() {
    local root="$1"
    id "$APP_USER" >/dev/null 2>&1 || die "application user ${APP_USER} does not exist"
    getent group "$APP_GROUP" >/dev/null 2>&1 || die "application group ${APP_GROUP} does not exist"
    assert_release_tree_shape "$root"
    chown -R root:root "$root"
    find "$root" -xdev -type d -exec chmod 0755 {} +
    find "$root" -xdev -type f -exec chmod 0644 {} +
    assert_immutable_release "$root"
}

prepare_production_release() {
    local root="$1"
    prepare_immutable_release "$root"
    assert_release_path_access_for_user "$root" "$APP_USER"
    assert_release_path_access_for_user "$root" "$VALIDATION_USER"
}

prepare_private_validation_release() {
    local root="$1"
    prepare_immutable_release "$root"
    assert_private_validation_release_access "$root"
}

assert_release_tree_access_for_user() {
    local root="$1"
    local runtime_user="$2"
    local key_file

