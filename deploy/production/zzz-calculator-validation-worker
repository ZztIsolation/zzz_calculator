#!/bin/bash

set -Eeuo pipefail
umask 077
export PATH="/usr/sbin:/usr/bin:/sbin:/bin"
export LC_ALL=C
unset BASH_ENV ENV CDPATH GLOBIGNORE NODE_OPTIONS NODE_PATH NPM_CONFIG_PREFIX \
    LD_PRELOAD LD_LIBRARY_PATH CURL_HOME LOCPATH || true
while read -r _ _ inherited_function; do
    unset -f "$inherited_function"
done < <(declare -F)
unalias -a 2>/dev/null || true
hash -r
IFS=$' \t\n'

readonly VALIDATION_USER="zzzvalidate"
readonly CAPABILITY_PROBE_MODE="--capability-probe"
readonly VALIDATION_CAPABILITY_SENTINEL=".zzz-sandbox-capability-v1"
readonly VALIDATION_CAPABILITY_SENTINEL_CONTENT="zzz-sandbox-capability-v1"
readonly VALIDATION_TMPFS_BYTES="$((128 * 1024 * 1024))"
readonly VALIDATION_TMPFS_INODES="16384"
readonly VALIDATION_RUN_TMPFS_BYTES="$((4 * 1024 * 1024))"
readonly VALIDATION_RUN_TMPFS_INODES="1024"
readonly PRODUCTION_STATE_DIR="/var/lib/zzz-calculator"
readonly PRODUCTION_RELEASE_ROOT="/opt/zzz_calculator"
readonly PRODUCTION_DEPLOY_ROOT="/var/lib/zzz-calculator-deploy"
readonly PRODUCTION_CURRENT_DATA="/opt/zzz_calculator/current/data"
readonly PRODUCTION_DOWNLOAD_ROOT="/srv/zzz-download-origin"
readonly HOST_RUNTIME_DIR="/run"
readonly HOST_TMP_DIR="/tmp"
readonly HOST_VAR_TMP_DIR="/var/tmp"
readonly HOST_SHM_DIR="/dev/shm"
readonly HOST_SYSVIPC_DIR="/proc/sysvipc"
readonly HOST_MQUEUE_DIR="/dev/mqueue"
readonly PRODUCTION_HEALTH_URL="http://127.0.0.1:8787/api/health"
readonly VALIDATION_BASE_URL="http://127.0.0.1:8788"
readonly EXIT_IDENTITY_CONTRACT=30
readonly EXIT_ARGUMENT_CONTRACT=31
readonly EXIT_ENVIRONMENT_CONTRACT=32
readonly EXIT_RELEASE_CONTRACT=33
readonly EXIT_PROBE_ROOT_CONTRACT=34
readonly EXIT_PROBE_TMPFS_CONTRACT=35
readonly EXIT_PROBE_TMPFS_SIZE=36
readonly EXIT_PROBE_ROOT_PERMISSIONS=37
readonly EXIT_RUN_TMPFS_CONTRACT=38
readonly EXIT_RUN_TMPFS_SIZE=39
readonly EXIT_PRODUCTION_STATE_EXPOSED=40
readonly EXIT_PRODUCTION_RELEASE_EXPOSED=41
readonly EXIT_PRODUCTION_DEPLOY_EXPOSED=42
readonly EXIT_PRODUCTION_CURRENT_DATA_EXPOSED=43
readonly EXIT_HOST_WRITABLE_PATH_EXPOSED=44
readonly EXIT_NETWORK_NAMESPACE_CONTRACT=45
readonly EXIT_NETWORK_INTERFACE_CONTRACT=46
readonly EXIT_PRODUCTION_NETWORK_REACHABLE=47
readonly EXIT_PROBE_DIRECTORY_SETUP=48
readonly EXIT_RELEASE_DATA_CONTRACT=49
readonly EXIT_CATALOG_CONTRACT=50
readonly EXIT_CATALOG_COPY=51
readonly EXIT_INVENTORY_COPY=52
readonly EXIT_INVENTORY_COMPARE=53
readonly EXIT_SERVER_EARLY_EXIT=54
readonly EXIT_SERVER_NOT_READY=55
readonly EXIT_SERVER_HEALTH_LOST=56
readonly EXIT_SERVER_ENDPOINT_FAILURE=57
readonly EXIT_PROCESS_STATUS_CONTRACT=60
readonly EXIT_NO_NEW_PRIVILEGES_CONTRACT=61
readonly EXIT_SECCOMP_CONTRACT=62
readonly EXIT_CAPABILITY_CONTRACT=63
readonly EXIT_TMPFS_MOUNT_OPTIONS=64
readonly EXIT_TMPFS_INODE_LIMIT=65
readonly EXIT_IPC_PATH_EXPOSED=66
readonly EXIT_IPC_DEPENDENCY_MISSING=67
readonly EXIT_IPC_DENIAL_UNPROVEN=68
readonly EXIT_IPC_SYSCALL_ALLOWED=69
readonly EXIT_IPC_CLEANUP_FAILED=70
readonly EXIT_PRODUCTION_DOWNLOAD_EXPOSED=71
readonly EXIT_PERSONALITY_DEPENDENCY_MISSING=72
readonly EXIT_PERSONALITY_DENIAL_UNPROVEN=73
readonly EXIT_PERSONALITY_SYSCALL_ALLOWED=74
readonly EXIT_CAPABILITY_SOURCE_CONTRACT=75
readonly -a VALIDATION_CATALOG_FILES=(
    agents.json
    agent_skills.json
    anomaly_effects.json
    bosses.json
    combat_buffs.json
    drive_disc_sets.json
    stat_rules.json
    w_engines.json
)

worker_mode="validate"
if [[ "${1:-}" == "$CAPABILITY_PROBE_MODE" ]]; then
    worker_mode="capability-probe"
    shift
elif [[ "${1:-}" == --* ]]; then
    printf 'validation worker error: unsupported mode\n' >&2
    exit "$EXIT_ARGUMENT_CONTRACT"
fi
release_dir="${1:-}"
probe_root="${2:-}"
server_pid=""

fail_worker() {
    local exit_code="$1"
    local message="$2"
    printf 'validation worker error: %s (exit=%s)\n' "$message" "$exit_code" >&2
    exit "$exit_code"
}

cleanup() {
    local attempt
    [[ -n "$server_pid" ]] || return 0
    kill -TERM "$server_pid" 2>/dev/null || true
    for attempt in $(seq 1 20); do
        kill -0 "$server_pid" 2>/dev/null || break
        sleep 0.1
    done
    kill -KILL "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
}

on_signal() {
    trap '' HUP INT TERM
    exit 128
}

trap cleanup EXIT
trap on_signal HUP INT TERM

read_process_status_field() {
    local requested_field="$1"
    local output_variable="$2"
    local key value="" matches="0"

    while IFS=: read -r key value; do
        if [[ "$key" == "$requested_field" ]]; then
            matches="$((matches + 1))"
            value="${value//[[:space:]]/}"
            printf -v "$output_variable" '%s' "$value"
        fi
    done </proc/self/status
    [[ "$matches" == "1" && -n "${!output_variable}" ]] \
        || fail_worker "$EXIT_PROCESS_STATUS_CONTRACT" "missing or duplicate ${requested_field} status field"
}

mount_options_contain() {
    local mount_options="$1"
    local super_options="$2"
    local required_option="$3"
    [[ ",${mount_options},${super_options}," == *",${required_option},"* ]]
}

EFFECTIVE_MOUNT_ID=""
EFFECTIVE_MOUNT_FILESYSTEM=""
EFFECTIVE_MOUNT_OPTIONS=""
EFFECTIVE_MOUNT_SUPER_OPTIONS=""

select_effective_mount_record() {
    local target="$1"
    local mountinfo_path="${2:-/proc/self/mountinfo}"
    local -a mount_fields=() mount_ids=() parent_ids=() filesystems=() mount_options=() super_options=()
    local -A candidate_index=() hidden_by_child=()
    local field_index separator_index mount_id parent_id candidate_count="0" top_index="" top_count="0"

    EFFECTIVE_MOUNT_ID=""
    EFFECTIVE_MOUNT_FILESYSTEM=""
    EFFECTIVE_MOUNT_OPTIONS=""
    EFFECTIVE_MOUNT_SUPER_OPTIONS=""
    [[ -r "$mountinfo_path" ]] || return 1

    while read -r -a mount_fields; do
        [[ "${mount_fields[4]:-}" == "$target" ]] || continue
        mount_id="${mount_fields[0]:-}"
        parent_id="${mount_fields[1]:-}"
        [[ "$mount_id" =~ ^[1-9][0-9]*$ && "$parent_id" =~ ^[1-9][0-9]*$ ]] || return 1
        [[ -z "${candidate_index[$mount_id]+present}" ]] || return 1
        separator_index=""
        for ((field_index = 6; field_index < ${#mount_fields[@]}; field_index += 1)); do
            if [[ "${mount_fields[$field_index]}" == "-" ]]; then
                separator_index="$field_index"
                break
            fi
        done
        [[ -n "$separator_index" && "$((separator_index + 3))" -lt "${#mount_fields[@]}" ]] || return 1
        candidate_index[$mount_id]="$candidate_count"
        mount_ids+=("$mount_id")
        parent_ids+=("$parent_id")
        mount_options+=("${mount_fields[5]}")
        filesystems+=("${mount_fields[$((separator_index + 1))]}")
        super_options+=("${mount_fields[$((separator_index + 3))]}")
        candidate_count="$((candidate_count + 1))"
    done <"$mountinfo_path"
    (( candidate_count > 0 )) || return 1

    for parent_id in "${parent_ids[@]}"; do
        if [[ -n "${candidate_index[$parent_id]+present}" ]]; then
            hidden_by_child[$parent_id]="1"
        fi
    done
    for ((field_index = 0; field_index < candidate_count; field_index += 1)); do
        mount_id="${mount_ids[$field_index]}"
        [[ -z "${hidden_by_child[$mount_id]+present}" ]] || continue
        top_index="$field_index"
        top_count="$((top_count + 1))"
    done
    [[ "$top_count" == "1" ]] || return 1

    EFFECTIVE_MOUNT_ID="${mount_ids[$top_index]}"
    EFFECTIVE_MOUNT_FILESYSTEM="${filesystems[$top_index]}"
    EFFECTIVE_MOUNT_OPTIONS="${mount_options[$top_index]}"
    EFFECTIVE_MOUNT_SUPER_OPTIONS="${super_options[$top_index]}"
}

assert_tmpfs_mount_contract() {
    local target="$1"
    local maximum_bytes="$2"
    local maximum_inodes="$3"
    local byte_limit_exit="$4"
    local actual_bytes actual_inodes required_option

    select_effective_mount_record "$target" /proc/self/mountinfo \
        || fail_worker "$EXIT_TMPFS_MOUNT_OPTIONS" "isolated tmpfs mount topology is invalid"
    [[ "$EFFECTIVE_MOUNT_FILESYSTEM" == "tmpfs" ]] \
        || fail_worker "$EXIT_TMPFS_MOUNT_OPTIONS" "isolated writable path is not an effective tmpfs mount"
    for required_option in rw nosuid nodev noexec; do
        mount_options_contain "$EFFECTIVE_MOUNT_OPTIONS" "$EFFECTIVE_MOUNT_SUPER_OPTIONS" "$required_option" \
            || fail_worker "$EXIT_TMPFS_MOUNT_OPTIONS" "isolated tmpfs is missing ${required_option}"
    done

    actual_bytes="$(/usr/bin/df --output=size -B1 "$target" | /usr/bin/tail -n 1 | /usr/bin/tr -d '[:space:]')"
    [[ "$actual_bytes" =~ ^[1-9][0-9]*$ && "$actual_bytes" -le "$maximum_bytes" ]] \
        || fail_worker "$byte_limit_exit" "isolated tmpfs exceeds its byte limit"
    actual_inodes="$(/usr/bin/df --output=itotal "$target" | /usr/bin/tail -n 1 | /usr/bin/tr -d '[:space:]')"
    [[ "$actual_inodes" =~ ^[1-9][0-9]*$ && "$actual_inodes" -le "$maximum_inodes" ]] \
        || fail_worker "$EXIT_TMPFS_INODE_LIMIT" "isolated tmpfs exceeds its inode limit"
}

assert_sysv_ipc_denied() {
    local ipc_kind="$1"
    local create_flag remove_flag create_argument="" output ipc_id

    case "$ipc_kind" in
        queue) create_flag="-Q"; remove_flag="-q" ;;
        semaphore) create_flag="-S"; create_argument="1"; remove_flag="-s" ;;
        shared-memory) create_flag="-M"; create_argument="4096"; remove_flag="-m" ;;
        *) fail_worker "$EXIT_IPC_DENIAL_UNPROVEN" "unknown IPC probe type" ;;
    esac

    if [[ -n "$create_argument" ]]; then
        if output="$(/usr/bin/ipcmk "$create_flag" "$create_argument" 2>&1)"; then
            :
        else
            [[ "$output" == *"Operation not permitted"* ]] \
                || fail_worker "$EXIT_IPC_DENIAL_UNPROVEN" "${ipc_kind} denial did not return EPERM"
            return 0
        fi
    elif output="$(/usr/bin/ipcmk "$create_flag" 2>&1)"; then
        :
    else
        [[ "$output" == *"Operation not permitted"* ]] \
            || fail_worker "$EXIT_IPC_DENIAL_UNPROVEN" "${ipc_kind} denial did not return EPERM"
        return 0
    fi

    ipc_id="${output##*:}"
    ipc_id="${ipc_id//[[:space:]]/}"
    [[ "$ipc_id" =~ ^[0-9]+$ ]] \
        || fail_worker "$EXIT_IPC_CLEANUP_FAILED" "${ipc_kind} was created but its ID could not be recovered"
    /usr/bin/ipcrm "$remove_flag" "$ipc_id" >/dev/null 2>&1 \
        || fail_worker "$EXIT_IPC_CLEANUP_FAILED" "${ipc_kind} was created and could not be removed"
    fail_worker "$EXIT_IPC_SYSCALL_ALLOWED" "${ipc_kind} creation syscall was not blocked"
}

assert_personality_denied() {
    local architecture output

    [[ -x /usr/bin/setarch && -x /usr/bin/uname && -x /usr/bin/true ]] \
        || fail_worker "$EXIT_PERSONALITY_DEPENDENCY_MISSING" "setarch, uname and true are required"
    architecture="$(/usr/bin/uname -m)" \
        || fail_worker "$EXIT_PERSONALITY_DENIAL_UNPROVEN" "native architecture could not be read"
    [[ "$architecture" =~ ^[A-Za-z0-9._-]+$ ]] \
        || fail_worker "$EXIT_PERSONALITY_DENIAL_UNPROVEN" "native architecture is invalid"

    if output="$(/usr/bin/setarch "$architecture" -R /usr/bin/true 2>&1)"; then
        fail_worker "$EXIT_PERSONALITY_SYSCALL_ALLOWED" "personality syscall was not blocked"
    fi
    [[ "$output" == *"Operation not permitted"* ]] \
        || fail_worker "$EXIT_PERSONALITY_DENIAL_UNPROVEN" "personality denial did not return EPERM"
}

assert_sandbox_contract() {
    local status_value="" capability_field hidden_writable_path hidden_ipc_path
    local -a interfaces=()

    read_process_status_field NoNewPrivs status_value
    [[ "$status_value" == "1" ]] \
        || fail_worker "$EXIT_NO_NEW_PRIVILEGES_CONTRACT" "NoNewPrivs is not enabled"
    read_process_status_field Seccomp status_value
    [[ "$status_value" == "2" ]] \
        || fail_worker "$EXIT_SECCOMP_CONTRACT" "seccomp filter mode is not enabled"
    for capability_field in CapInh CapPrm CapEff CapBnd CapAmb; do
        read_process_status_field "$capability_field" status_value
        [[ "$status_value" =~ ^0+$ ]] \
            || fail_worker "$EXIT_CAPABILITY_CONTRACT" "${capability_field} is not empty"
    done

    [[ -d "$probe_root" && ! -L "$probe_root" && -w "$probe_root" ]] \
        || fail_worker "$EXIT_PROBE_ROOT_CONTRACT" "isolated probe root is invalid"
    [[ "$(/usr/bin/stat -f -c %T -- "$probe_root")" == "tmpfs" ]] \
        || fail_worker "$EXIT_PROBE_TMPFS_CONTRACT" "isolated probe root is not tmpfs"
    [[ "$(/usr/bin/stat -c '%U:%G:%a' -- "$probe_root")" == "$VALIDATION_USER:$VALIDATION_USER:700" ]] \
        || fail_worker "$EXIT_PROBE_ROOT_PERMISSIONS" "isolated probe root permissions are invalid"
    [[ "$(/usr/bin/stat -f -c %T -- "$HOST_RUNTIME_DIR")" == "tmpfs" ]] \
        || fail_worker "$EXIT_RUN_TMPFS_CONTRACT" "isolated runtime path is not tmpfs"
    assert_tmpfs_mount_contract "$probe_root" "$VALIDATION_TMPFS_BYTES" \
        "$VALIDATION_TMPFS_INODES" "$EXIT_PROBE_TMPFS_SIZE"
    assert_tmpfs_mount_contract "$HOST_RUNTIME_DIR" "$VALIDATION_RUN_TMPFS_BYTES" \
        "$VALIDATION_RUN_TMPFS_INODES" "$EXIT_RUN_TMPFS_SIZE"

    [[ ! -r "$PRODUCTION_STATE_DIR" && ! -w "$PRODUCTION_STATE_DIR" && ! -x "$PRODUCTION_STATE_DIR" ]] \
        || fail_worker "$EXIT_PRODUCTION_STATE_EXPOSED" "production state is reachable"
    [[ ! -r "$PRODUCTION_RELEASE_ROOT" && ! -w "$PRODUCTION_RELEASE_ROOT" && ! -x "$PRODUCTION_RELEASE_ROOT" ]] \
        || fail_worker "$EXIT_PRODUCTION_RELEASE_EXPOSED" "production releases are reachable"
    [[ ! -r "$PRODUCTION_DEPLOY_ROOT" && ! -w "$PRODUCTION_DEPLOY_ROOT" && ! -x "$PRODUCTION_DEPLOY_ROOT" ]] \
        || fail_worker "$EXIT_PRODUCTION_DEPLOY_EXPOSED" "production deployment state is reachable"
    [[ ! -r "$PRODUCTION_CURRENT_DATA" && ! -w "$PRODUCTION_CURRENT_DATA" && ! -x "$PRODUCTION_CURRENT_DATA" ]] \
        || fail_worker "$EXIT_PRODUCTION_CURRENT_DATA_EXPOSED" "production current data is reachable"
    [[ ! -r "$PRODUCTION_DOWNLOAD_ROOT" && ! -w "$PRODUCTION_DOWNLOAD_ROOT" && ! -x "$PRODUCTION_DOWNLOAD_ROOT" ]] \
        || fail_worker "$EXIT_PRODUCTION_DOWNLOAD_EXPOSED" "production download origin is reachable"
    for hidden_writable_path in "$HOST_TMP_DIR" "$HOST_VAR_TMP_DIR" "$HOST_SHM_DIR"; do
        [[ ! -r "$hidden_writable_path" && ! -w "$hidden_writable_path" && ! -x "$hidden_writable_path" ]] \
            || fail_worker "$EXIT_HOST_WRITABLE_PATH_EXPOSED" "host writable path is reachable"
    done
    for hidden_ipc_path in "$HOST_SYSVIPC_DIR" "$HOST_MQUEUE_DIR"; do
        [[ ! -r "$hidden_ipc_path" && ! -w "$hidden_ipc_path" && ! -x "$hidden_ipc_path" ]] \
            || fail_worker "$EXIT_IPC_PATH_EXPOSED" "host IPC discovery path is reachable"
    done

    # PrivateNetwork must produce a namespace distinct from PID 1 with only loopback.
    [[ "$(readlink /proc/self/ns/net)" != "$(readlink /proc/1/ns/net)" ]] \
        || fail_worker "$EXIT_NETWORK_NAMESPACE_CONTRACT" "network namespace is shared with PID 1"
    interfaces=(/sys/class/net/*)
    [[ "${#interfaces[@]}" -eq 1 && "${interfaces[0]##*/}" == "lo" ]] \
        || fail_worker "$EXIT_NETWORK_INTERFACE_CONTRACT" "network namespace contains a non-loopback interface"
    if curl --disable --fail --silent --max-time 1 "$PRODUCTION_HEALTH_URL" >/dev/null 2>&1; then
        fail_worker "$EXIT_PRODUCTION_NETWORK_REACHABLE" "production health endpoint is reachable"
    fi

    [[ -x /usr/bin/ipcmk && -x /usr/bin/ipcrm ]] \
        || fail_worker "$EXIT_IPC_DEPENDENCY_MISSING" "ipcmk and ipcrm are required"
    assert_sysv_ipc_denied queue
    assert_sysv_ipc_denied semaphore
    assert_sysv_ipc_denied shared-memory
    assert_personality_denied
}

[[ "$(id -un)" == "$VALIDATION_USER" && "$(id -G)" == "$(id -g)" ]] \
    || fail_worker "$EXIT_IDENTITY_CONTRACT" "validation identity or group set is invalid"
[[ "$#" -eq 2 && -n "$release_dir" && -n "$probe_root" ]] \
    || fail_worker "$EXIT_ARGUMENT_CONTRACT" "expected release and probe-root arguments"
[[ "$HOME" == "$probe_root/home" && "${ZZZ_CALCULATOR_DATA_DIR:-}" == "$probe_root/data" ]] \
    || fail_worker "$EXIT_ENVIRONMENT_CONTRACT" "isolated HOME or data directory is invalid"

assert_sandbox_contract
if [[ "$worker_mode" == "capability-probe" ]]; then
    capability_sentinel="${release_dir}/${VALIDATION_CAPABILITY_SENTINEL}"
    [[ -f "$capability_sentinel" && ! -L "$capability_sentinel" \
        && -r "$capability_sentinel" \
        && "$(<"$capability_sentinel")" == "$VALIDATION_CAPABILITY_SENTINEL_CONTENT" ]] \
        || fail_worker "$EXIT_CAPABILITY_SOURCE_CONTRACT" "capability bind source sentinel is missing or invalid"
    exit 0
fi

[[ -d "$release_dir" && ! -L "$release_dir" && -r "$release_dir/backend/server.js" ]] \
    || fail_worker "$EXIT_RELEASE_CONTRACT" "validation release is invalid"

for path in home data tmp run xdg-cache xdg-config xdg-data; do
    /usr/bin/mkdir -m 0700 -- "$probe_root/$path" \
        || fail_worker "$EXIT_PROBE_DIRECTORY_SETUP" "isolated runtime directory could not be created"
done
[[ -d "$release_dir/data" && ! -L "$release_dir/data" ]] \
    || fail_worker "$EXIT_RELEASE_DATA_CONTRACT" "validation release data directory is invalid"
for catalog_name in "${VALIDATION_CATALOG_FILES[@]}" user_drive_discs.example.json; do
    catalog_path="$release_dir/data/$catalog_name"
    [[ -f "$catalog_path" && ! -L "$catalog_path" ]] \
        || fail_worker "$EXIT_CATALOG_CONTRACT" "validation catalog is missing or unsafe"
    /usr/bin/cp -- "$catalog_path" "$probe_root/data/$catalog_name" \
        || fail_worker "$EXIT_CATALOG_COPY" "validation catalog could not be copied"
done
/usr/bin/cp -- "$release_dir/data/user_drive_discs.example.json" \
    "$probe_root/data/user_drive_discs.json" \
    || fail_worker "$EXIT_INVENTORY_COPY" "isolated inventory could not be created"
/usr/bin/cmp -- "$probe_root/data/user_drive_discs.example.json" \
    "$probe_root/data/user_drive_discs.json" \
    || fail_worker "$EXIT_INVENTORY_COMPARE" "isolated inventory differs from its seed"

/usr/bin/node "$release_dir/backend/server.js" >/dev/null 2>&1 &
server_pid="$!"
ready="0"
for attempt in $(seq 1 15); do
    kill -0 "$server_pid" 2>/dev/null \
        || fail_worker "$EXIT_SERVER_EARLY_EXIT" "candidate server exited before readiness"
    if curl --disable --fail --silent --show-error --max-time 1 \
        "$VALIDATION_BASE_URL/api/health" >"$probe_root/run/response.json" 2>/dev/null \
        && jq -e '.ok == true' "$probe_root/run/response.json" >/dev/null 2>&1; then
        ready="1"
        break
    fi
    sleep 1
done
[[ "$ready" == "1" ]] \
    || fail_worker "$EXIT_SERVER_NOT_READY" "candidate server did not become ready"

kill -0 "$server_pid" 2>/dev/null \
    || fail_worker "$EXIT_SERVER_HEALTH_LOST" "candidate server stopped after readiness"
curl --disable --fail --silent --show-error --max-time 3 \
    "$VALIDATION_BASE_URL/api/catalog" >"$probe_root/run/response.json" \
    || fail_worker "$EXIT_SERVER_ENDPOINT_FAILURE" "candidate catalog endpoint failed"
jq -e '(.agents | type) == "array"' "$probe_root/run/response.json" >/dev/null \
    || fail_worker "$EXIT_SERVER_ENDPOINT_FAILURE" "candidate catalog response is invalid"
curl --disable --fail --silent --show-error --max-time 3 \
    "$VALIDATION_BASE_URL/api/app-config" >"$probe_root/run/response.json" \
    || fail_worker "$EXIT_SERVER_ENDPOINT_FAILURE" "candidate app-config endpoint failed"
jq -e '.maintenanceEnabled == false' "$probe_root/run/response.json" >/dev/null \
    || fail_worker "$EXIT_SERVER_ENDPOINT_FAILURE" "candidate app-config response is invalid"
kill -0 "$server_pid" 2>/dev/null \
    || fail_worker "$EXIT_SERVER_ENDPOINT_FAILURE" "candidate server stopped during endpoint checks"
